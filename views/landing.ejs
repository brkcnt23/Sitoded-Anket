<%- include('public/header') %><main id="main">
<section class="hero"><div class="wrap hero-grid"><div class="hero-copy"><span class="eyebrow"><span class="accent-rule"></span><%= t('2006’DAN BERİ · ERZURUM’DAN DÜNYAYA','SINCE 2006 · FROM ERZURUM TO THE WORLD') %></span><h1><%= t('Küresel düşün.','Think global.') %><br><em><%= t('Yerel hareket et.','Act local.') %></em></h1><p class="hero-lead"><%= t('Bir fikrin, bir gönüllünün, bir şehrin değiştirebileceği çok şey var.','An idea, a volunteer, a city. Each can change so much.') %></p><p class="hero-detail"><%= t('Gençlerin enerjisini sivil toplumun gücüyle buluşturuyor; Erzurum’dan dünyaya öğrenme, dayanışma ve katılım alanları açıyoruz.','We connect the energy of young people with civil society, opening spaces for learning, solidarity and participation.') %></p><div class="button-row"><a class="button" href="<%= surveyUrl %>"><%= t('Birlikte harekete geçelim','Let’s take action together') %> ↗</a><a class="text-link" href="<%= url('/projeler') %>"><%= t('Projelerimizi keşfedin','Explore our projects') %> →</a></div></div><figure class="hero-editorial"><%- include('public/picture',{name:'hero',priority:true,alt:t('Erzurum’da birlikte proje planlayan gençleri anlatan illüstrasyon','Illustration of young people planning a project in Erzurum')}) %><figcaption><span>ERZURUM / TÜRKİYE</span><strong><%= t('Birlikte mümkün.','Possible, together.') %></strong><span><%= t('Temsili illüstrasyon','Conceptual illustration') %></span></figcaption></figure></div></section>
<div class="facts-strip"><div class="wrap facts-grid"><div><strong>2006</strong><span><%= t('Şubat ayında başlayan yolculuk','Our journey began in February') %></span></div><div><strong>≈100</strong><span><%= t('Tamamı gönüllü üye','Members, all volunteers') %></span></div><div><strong>7</strong><span><%= t('Birbirini tamamlayan çalışma alanı','Connected areas of action') %></span></div><div><strong><%= t('Ortak gelecek','A shared future') %></strong><span><%= t('Yerel bilgi, uluslararası deneyim','Local knowledge, global experience') %></span></div></div></div>
<section class="section"><div class="wrap story-grid"><div class="story-photo"><%- include('public/picture',{name:'culture'}) %><span class="photo-footnote"><%= t('Yerelden güç alan bir hikâye.','A story rooted in our city.') %></span></div><div><span class="eyebrow"><%= t('BİZ KİMİZ?','WHO WE ARE') %></span><h2><%= t('Birlikte öğreniyor,','Learning together.') %><br><%= t('birlikte güçleniyoruz.','Growing stronger together.') %></h2><p class="lead"><%= t('SİTODED, gençlerin ve sivil toplumun potansiyelini harekete geçirmek için Şubat 2006’da Erzurum’da kuruldu.','SİTODED was founded in Erzurum in February 2006 to help young people and civil society realise their potential.') %></p><p><%= t('Bugün yaklaşık 100 gönüllü üyemizle yerel ihtiyaçlara karşılık veren çalışmalar yürütüyor, edindiğimiz uluslararası deneyimi şehrimizle paylaşıyoruz.','Today, around 100 volunteer members respond to local needs and bring international experience back to our city.') %></p><a class="text-link" href="<%= url('/hakkimizda') %>"><%= t('Hikâyemizi tanıyın','Discover our story') %> →</a></div></div></section>
<section class="section soft-section"><div class="wrap"><div class="section-heading"><div><span class="eyebrow"><%= t('BİRLİKTE ETKİ YARATIYORUZ','MAKING A DIFFERENCE TOGETHER') %></span><h2><%= t('Yedi alan, ortak bir amaç.','Seven areas. One shared purpose.') %></h2></div><a class="text-link" href="<%= url('/calisma-alanlari') %>"><%= t('Tüm çalışma alanları','All areas of action') %> ↗</a></div><div class="work-ribbon"><% areas.forEach((a,i)=>{const icons=['people','book','access','spark','pin','sports','leaf']; %><a href="<%= url('/calisma-alanlari/'+a[0]) %>"><%- include('shared/icon',{name:icons[i]}) %><span><%= t(a[1],a[2]) %></span><span class="work-link-arrow">↗</span></a><% }) %></div></div></section>
<section class="section"><div class="wrap"><div class="section-heading"><div><span class="eyebrow"><%= t('PROJE ARŞİVİMİZDEN','FROM OUR PROJECT ARCHIVE') %></span><h2><%= t('Bir fikirden, birlikte etkiye.','From an idea to shared impact.') %></h2></div><a class="text-link" href="<%= url('/projeler') %>"><%= t('Tüm projeler','All projects') %> ↗</a></div><div class="project-grid"><% ['dogayi-degil-bisikleti-kullan','kucuk-yurekler-eglenerek-ogreniyor','sessiz-sohbetler'].map(slug=>projects.find(p=>p.slug===slug)).filter(Boolean).forEach(p=>{ %><%- include('public/project-card',{p}) %><% }) %></div></div></section>
<section class="climate-feature"><div class="wrap climate-feature-grid"><div><span class="eyebrow">CLIMATE ZERO · COP31</span><h2><%= t('Gelecek için öğren.','Learn for the future.') %><br><em><%= t('İklim için harekete geç.','Take action for the climate.') %></em></h2><p><%= t('SİTODED’in yürüttüğü Climate Zero eğitimlerinden COP31’e: iklim bilgisini yerel deneyimle buluşturuyoruz.','From SİTODED’s Climate Zero training to COP31: connecting climate learning with local experience.') %></p><a class="button" href="<%= url('/cop31') %>"><%= t('İklim çalışmalarımız','Our climate work') %> ↗</a></div><div class="climate-feature-art"><%- include('public/picture',{name:'climate'}) %><div class="event-note"><strong>COP31 / ANTALYA</strong><span><%= t('9–20 Kasım 2026','9–20 November 2026') %></span></div></div></div></section>
<section class="section"><div class="wrap"><div class="section-heading"><div><span class="eyebrow"><%= t('DERNEKTEN HABERLER','NEWS FROM OUR ASSOCIATION') %></span><h2><%= t('Dünyaya açılan fırsatlar.','Opportunities beyond borders.') %></h2></div><a class="text-link" href="<%= url('/haberler') %>"><%= t('Tüm haberler','All news') %> ↗</a></div><div class="news-grid"><% news.forEach(n=>{ %><%- include('public/news-card',{n}) %><% }) %></div></div></section>
<%- include('public/join') %></main><%- include('public/footer') %>
