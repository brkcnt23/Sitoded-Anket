<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Etkinlik Katılımcıları - Sitoded Erzurum</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container-fluid">
            <a class="navbar-brand fw-bold" href="/dashboard">Sitoded Erzurum</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="/dashboard">Etkinlikler</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/logout">Çıkış Yap</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container mt-4">
        <h2><%- event.title %> - Katılımcı Listesi</h2>
        <p class="text-muted">Toplam Kontenjan: <strong><%- event.capacity %></strong></p>

        <ul class="nav nav-tabs mb-3" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="confirmed-tab" data-bs-toggle="tab" data-bs-target="#confirmed" type="button" role="tab">
                    Onaylı (<span id="confirmed-count">0</span>)
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="queue-tab" data-bs-toggle="tab" data-bs-target="#queue" type="button" role="tab">
                    Sırada (<span id="queue-count">0</span>)
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="cancelled-tab" data-bs-toggle="tab" data-bs-target="#cancelled" type="button" role="tab">
                    İptal Edildi (<span id="cancelled-count">0</span>)
                </button>
            </li>
        </ul>

        <div class="tab-content">
            <div class="tab-pane fade show active" id="confirmed" role="tabpanel">
                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Sıra</th>
                                <th>Ad Soyad</th>
                                <th>Email</th>
                                <th>Kayıt Tarihi</th>
                            </tr>
                        </thead>
                        <tbody id="confirmed-body">
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="tab-pane fade" id="queue" role="tabpanel">
                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Sıra</th>
                                <th>Ad Soyad</th>
                                <th>Email</th>
                                <th>Sıra Pozisyonu</th>
                                <th>Kayıt Tarihi</th>
                            </tr>
                        </thead>
                        <tbody id="queue-body">
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="tab-pane fade" id="cancelled" role="tabpanel">
                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Ad Soyad</th>
                                <th>Email</th>
                                <th>İptal Tarihi</th>
                            </tr>
                        </thead>
                        <tbody id="cancelled-body">
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="mt-4">
            <a href="/dashboard" class="btn btn-secondary">Geri Dön</a>
        </div>
    </div>

    <footer class="bg-dark text-white text-center py-3 mt-5">
        <p>&copy; 2026 Sitoded Erzurum</p>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const registrations = JSON.parse('<%- JSON.stringify(registrations) %>');
        
        let confirmedCount = 0, queueCount = 0, cancelledCount = 0;
        const confirmed = [], queue = [], cancelled = [];

        registrations.forEach((reg, idx) => {
            if (reg.status === 'CONFIRMED') {
                confirmed.push({...reg, idx: confirmedCount + 1});
                confirmedCount++;
            } else if (reg.status === 'REGISTERED') {
                queue.push({...reg, idx: queueCount + 1});
                queueCount++;
            } else if (reg.status === 'CANCELLED') {
                cancelled.push({...reg, idx: cancelledCount + 1});
                cancelledCount++;
            }
        });

        // Populate tables
        document.getElementById('confirmed-count').textContent = confirmedCount;
        document.getElementById('queue-count').textContent = queueCount;
        document.getElementById('cancelled-count').textContent = cancelledCount;

        // Confirmed
        const confirmedBody = document.getElementById('confirmed-body');
        confirmed.forEach(reg => {
            confirmedBody.innerHTML += `
                <tr>
                    <td>${reg.idx}</td>
                    <td>${reg.full_name}</td>
                    <td>${reg.email}</td>
                    <td>${new Date(reg.registered_at).toLocaleString('tr-TR')}</td>
                </tr>
            `;
        });

        // Queue
        const queueBody = document.getElementById('queue-body');
        queue.forEach(reg => {
            queueBody.innerHTML += `
                <tr>
                    <td>${reg.idx}</td>
                    <td>${reg.full_name}</td>
                    <td>${reg.email}</td>
                    <td>${reg.queue_position}</td>
                    <td>${new Date(reg.registered_at).toLocaleString('tr-TR')}</td>
                </tr>
            `;
        });

        // Cancelled
        const cancelledBody = document.getElementById('cancelled-body');
        cancelled.forEach(reg => {
            cancelledBody.innerHTML += `
                <tr>
                    <td>${reg.full_name}</td>
                    <td>${reg.email}</td>
                    <td>${reg.cancelled_at ? new Date(reg.cancelled_at).toLocaleString('tr-TR') : '-'}</td>
                </tr>
            `;
        });
    </script>
</body>
</html>
