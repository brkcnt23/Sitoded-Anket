<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Yoklama - Sitoded Anket</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --primary: #1F2937;
            --success: #10B981;
            --danger: #EF4444;
            --info: #3B82F6;
            --bg: #F9FAFB;
            --bg-white: #FFFFFF;
            --text-dark: #111827;
            --text-gray: #6B7280;
            --border: #E5E7EB;
            --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background-color: var(--bg);
            color: var(--text-dark);
        }

        .nav {
            background-color: var(--bg-white);
            border-bottom: 1px solid var(--border);
            padding: 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            box-shadow: var(--shadow-md);
        }

        .container {
            max-width: 900px;
            margin: 30px auto;
            padding: 0 20px;
        }

        .event-info {
            background-color: var(--bg-white);
            border-radius: 12px;
            padding: 25px;
            margin-bottom: 30px;
            box-shadow: var(--shadow-md);
            border: 1px solid var(--border);
            border-left: 4px solid var(--info);
        }

        .event-title {
            font-size: 24px;
            font-weight: 700;
            margin-bottom: 10px;
        }

        .event-details {
            display: flex;
            gap: 30px;
            flex-wrap: wrap;
            font-size: 14px;
            color: var(--text-gray);
        }

        .detail-item {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .section {
            background-color: var(--bg-white);
            border-radius: 12px;
            padding: 25px;
            margin-bottom: 30px;
            box-shadow: var(--shadow-md);
            border: 1px solid var(--border);
        }

        .section-header {
            font-size: 18px;
            font-weight: 700;
            margin-bottom: 20px;
            padding-bottom: 15px;
            border-bottom: 2px solid var(--border);
        }

        .actions {
            display: flex;
            gap: 10px;
            margin-bottom: 20px;
        }

        .btn {
            padding: 10px 15px;
            border: none;
            border-radius: 6px;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
        }

        .btn-primary {
            background-color: var(--info);
            color: white;
        }

        .btn-primary:hover {
            background-color: #2563EB;
        }

        .btn-success {
            background-color: var(--success);
            color: white;
        }

        .btn-success:hover {
            background-color: #059669;
        }

        .btn-secondary {
            background-color: var(--border);
            color: var(--text-dark);
        }

        .btn-secondary:hover {
            background-color: #D1D5DB;
        }

        .attendance-list {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .attendance-item {
            display: flex;
            align-items: center;
            gap: 15px;
            padding: 15px;
            border: 1px solid var(--border);
            border-radius: 6px;
            transition: all 0.2s;
        }

        .attendance-item:hover {
            background-color: var(--bg);
        }

        .attendance-item input[type="checkbox"] {
            width: 20px;
            height: 20px;
            cursor: pointer;
            accent-color: var(--success);
        }

        .attendance-item.attended {
            background-color: #ECFDF5;
            border-color: var(--success);
        }

        .attendance-info {
            flex: 1;
        }

        .user-name {
            font-weight: 600;
            margin-bottom: 4px;
        }

        .user-email {
            font-size: 12px;
            color: var(--text-gray);
        }

        .alert {
            padding: 15px;
            border-radius: 6px;
            margin-bottom: 20px;
            border-left: 4px solid;
        }

        .alert-success {
            background-color: #D1FAE5;
            color: #065F46;
            border-left-color: var(--success);
        }

        .alert-error {
            background-color: #FEE2E2;
            color: #7F1D1D;
            border-left-color: var(--danger);
        }

        .empty-state {
            text-align: center;
            padding: 40px;
            color: var(--text-gray);
        }

        @media (max-width: 768px) {
            .event-details {
                flex-direction: column;
                gap: 15px;
            }

            .actions {
                flex-direction: column;
            }

            .btn {
                width: 100%;
            }
        }
    </style>
</head>
<body>
    <div class="nav">
        <h2>📋 Yoklama Kaydı</h2>
        <a href="/dashboard" style="text-decoration: none; color: var(--info); font-weight: 600;">← Dashboard</a>
    </div>

    <div class="container">
        <!-- Event Info -->
        <div class="event-info">
            <div class="event-title"><%= event.title %></div>
            <div class="event-details">
                <div class="detail-item">
                    <span>📅</span>
                    <span><%= new Date(event.event_date).toLocaleDateString('tr-TR', { 
                        weekday: 'long', 
                        year: 'numeric', 
                        month: 'long', 
                        day: 'numeric' 
                    }) %></span>
                </div>
                <div class="detail-item">
                    <span>⏰</span>
                    <span><%= event.start_time %> - <%= event.end_time %></span>
                </div>
                <div class="detail-item">
                    <span>📍</span>
                    <span><%= event.location %></span>
                </div>
            </div>
        </div>

        <!-- Attendance Section -->
        <div class="section">
            <div class="section-header">👥 Katılımcı Yoklaması (<%= registrations.length %>)</div>

            <div class="actions">
                <button class="btn btn-success" onclick="markAllAttended()">✓ Tümü Katıldı</button>
                <button class="btn btn-secondary" onclick="clearAll()">↺ Temizle</button>
                <button class="btn btn-primary" onclick="saveAttendance()">💾 Kaydet</button>
            </div>

            <div id="alertContainer"></div>

            <% if (registrations.length === 0) { %>
            <div class="empty-state">
                <p>Bu etkinliğe onaylanan katılımcı bulunmamaktadır</p>
            </div>
            <% } else { %>
            <div class="attendance-list" id="attendanceList">
                <% registrations.forEach(reg => { %>
                <div class="attendance-item" id="item-<%= reg.user_id %>">
                    <input 
                        type="checkbox" 
                        name="attendance" 
                        value="<%= reg.user_id %>" 
                        <%= reg.attended === true ? 'checked' : '' %>
                        onchange="updateItemStyle(this)"
                    >
                    <div class="attendance-info">
                        <div class="user-name"><%= reg.full_name %></div>
                        <div class="user-email"><%= reg.email %></div>
                    </div>
                </div>
                <% }); %>
            </div>
            <% } %>
        </div>
    </div>

    <script>
        function updateItemStyle(checkbox) {
            const item = checkbox.closest('.attendance-item');
            if (checkbox.checked) {
                item.classList.add('attended');
            } else {
                item.classList.remove('attended');
            }
        }

        function markAllAttended() {
            const checkboxes = document.querySelectorAll('input[name="attendance"]');
            checkboxes.forEach(cb => {
                cb.checked = true;
                updateItemStyle(cb);
            });
        }

        function clearAll() {
            const checkboxes = document.querySelectorAll('input[name="attendance"]');
            checkboxes.forEach(cb => {
                cb.checked = false;
                updateItemStyle(cb);
            });
        }

        async function saveAttendance() {
            const eventId = <%= event.id %>;
            const checkboxes = document.querySelectorAll('input[name="attendance"]:checked');
            
            const attendances = Array.from(checkboxes).map(cb => ({
                user_id: parseInt(cb.value),
                attended: true
            }));

            // Add non-attended users
            const allCheckboxes = document.querySelectorAll('input[name="attendance"]');
            allCheckboxes.forEach(cb => {
                if (!cb.checked) {
                    attendances.push({
                        user_id: parseInt(cb.value),
                        attended: false
                    });
                }
            });

            try {
                const response = await fetch(`/api/event/${eventId}/attendance/batch`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ attendances })
                });

                const data = await response.json();

                if (data.success) {
                    showAlert('Yoklama başarıyla kaydedildi! ✓', 'success');
                    setTimeout(() => {
                        window.location.href = '/dashboard';
                    }, 2000);
                } else {
                    showAlert(data.error, 'error');
                }
            } catch (err) {
                console.error(err);
                showAlert('Hata: ' + err.message, 'error');
            }
        }

        function showAlert(message, type) {
            const container = document.getElementById('alertContainer');
            const alert = document.createElement('div');
            alert.className = `alert alert-${type}`;
            alert.textContent = message;
            container.innerHTML = '';
            container.appendChild(alert);

            if (type === 'success') {
                setTimeout(() => alert.remove(), 3000);
            }
        }

        // Initialize styles on load
        document.addEventListener('DOMContentLoaded', () => {
            document.querySelectorAll('input[name="attendance"]:checked').forEach(cb => {
                updateItemStyle(cb);
            });
        });
    </script>
</body>
</html>
