<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Etkinlik Oluştur — Sitoded</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600;700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

    :root {
      --bg:       #0c0c0f;
      --surface:  #131318;
      --surface2: #1a1a22;
      --border:   rgba(255,255,255,0.07);
      --border2:  rgba(255,255,255,0.12);
      --text:     #e8e8f0;
      --muted:    #7070a0;
      --accent:   #6c63ff;
      --accent2:  #8b85ff;
      --green:    #22c55e;
      --red:      #ef4444;
    }

    body {
      font-family: 'DM Sans', sans-serif;
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
    }

    /* ── TOPBAR ── */
    .topbar {
      height: 60px;
      background: var(--surface);
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 32px;
      position: sticky;
      top: 0;
      z-index: 50;
    }

    .topbar-left {
      display: flex;
      align-items: center;
      gap: 16px;
    }

    .back-btn {
      display: flex;
      align-items: center;
      gap: 6px;
      color: var(--muted);
      font-size: 13px;
      font-weight: 500;
      text-decoration: none;
      padding: 6px 10px;
      border-radius: 7px;
      transition: all 0.15s;
      border: 1px solid var(--border);
    }

    .back-btn:hover { background: var(--surface2); color: var(--text); }

    .topbar-title {
      font-size: 15px;
      font-weight: 600;
      color: var(--text);
    }

    .topbar-right {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    /* ── PAGE ── */
    .page {
      max-width: 1000px;
      margin: 40px auto;
      padding: 0 24px 80px;
    }

    .page-header {
      margin-bottom: 32px;
    }

    .page-header h1 {
      font-size: 26px;
      font-weight: 700;
      color: var(--text);
      letter-spacing: -0.5px;
      margin-bottom: 6px;
    }

    .page-header p {
      font-size: 14px;
      color: var(--muted);
    }

    /* ── TWO COLUMN LAYOUT ── */
    .form-layout {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
      align-items: start;
    }

    /* ── CARD ── */
    .card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 14px;
      overflow: hidden;
    }

    .card-header {
      padding: 16px 24px;
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .card-header-icon {
      width: 30px; height: 30px;
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 15px;
    }

    .card-header h3 {
      font-size: 13px;
      font-weight: 700;
      color: var(--text);
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .card-body {
      padding: 20px 24px;
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    /* ── FORM ELEMENTS ── */
    .form-group {
      display: flex;
      flex-direction: column;
      gap: 7px;
    }

    .form-label {
      font-size: 12px;
      font-weight: 600;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 0.5px;
      display: flex;
      align-items: center;
      gap: 4px;
    }

    .required { color: var(--red); }

    .form-control {
      background: var(--surface2);
      border: 1px solid var(--border2);
      border-radius: 9px;
      padding: 11px 14px;
      font-size: 14px;
      color: var(--text);
      font-family: 'DM Sans', sans-serif;
      outline: none;
      transition: all 0.15s;
      width: 100%;
    }

    .form-control:focus {
      border-color: var(--accent);
      box-shadow: 0 0 0 3px rgba(108,99,255,0.12);
    }

    .form-control::placeholder { color: var(--muted); }
    select.form-control option { background: #1a1a22; }

    textarea.form-control {
      resize: vertical;
      min-height: 110px;
      line-height: 1.6;
    }

    .form-hint {
      font-size: 12px;
      color: var(--muted);
      line-height: 1.4;
    }

    /* ── TIME ROW ── */
    .time-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }

    .time-row .form-label {
      font-size: 11px;
      margin-bottom: 4px;
    }

    /* ── CAPACITY PREVIEW ── */
    .capacity-preview {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 10px 14px;
      background: rgba(108,99,255,0.08);
      border: 1px solid rgba(108,99,255,0.15);
      border-radius: 9px;
      font-size: 13px;
      color: var(--accent2);
      font-weight: 500;
    }

    /* ── ERROR ── */
    .alert-error {
      padding: 12px 16px;
      border-radius: 9px;
      background: rgba(239,68,68,0.1);
      border: 1px solid rgba(239,68,68,0.25);
      color: #fca5a5;
      font-size: 13px;
      margin-bottom: 20px;
    }

    /* ── BUTTONS ── */
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 7px;
      padding: 11px 22px;
      border-radius: 9px;
      font-size: 14px;
      font-weight: 600;
      font-family: 'DM Sans', sans-serif;
      cursor: pointer;
      border: none;
      transition: all 0.15s;
      text-decoration: none;
    }

    .btn-primary { background: var(--accent); color: white; }
    .btn-primary:hover { background: var(--accent2); transform: translateY(-1px); }
    .btn-primary:active { transform: translateY(0); }

    .btn-ghost {
      background: transparent;
      color: var(--muted);
      border: 1px solid var(--border2);
    }
    .btn-ghost:hover { background: var(--surface2); color: var(--text); }

    /* ── SUBMIT ROW ── */
    .submit-row {
      grid-column: 1 / -1;
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 10px;
      padding-top: 4px;
    }

    .submit-hint {
      font-size: 12px;
      color: var(--muted);
      margin-right: auto;
    }

    /* ── RESPONSIVE ── */
    @media (max-width: 720px) {
      .form-layout { grid-template-columns: 1fr; }
      .submit-row { grid-column: 1; }
      .page { margin: 20px auto; }
      .page-header h1 { font-size: 20px; }
    }
  </style>
</head>
<body>

<header class="topbar">
  <div class="topbar-left">
    <a href="/dashboard" class="back-btn">
      <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 5l-7 7 7 7"/></svg>
      Geri
    </a>
    <span class="topbar-title">Yeni Etkinlik</span>
  </div>
  <div class="topbar-right">
    <span style="font-size:13px; color: var(--muted);">Lider olarak: <strong style="color:var(--text)"><%= user.full_name %></strong></span>
  </div>
</header>

<div class="page">
  <div class="page-header">
    <h1>Etkinlik Oluştur</h1>
    <p>Gelecek hafta için yeni bir etkinlik planla. Kayıt deadline'ı bu Pazar 23:59.</p>
  </div>

  <% if (typeof error !== 'undefined' && error) { %>
  <div class="alert-error">⚠ <%= error %></div>
  <% } %>

  <form method="POST" action="/events/create" id="eventForm">
    <div class="form-layout">

      <!-- SOL KOLON: Temel Bilgiler -->
      <div style="display:flex; flex-direction:column; gap:20px;">

        <div class="card">
          <div class="card-header">
            <div class="card-header-icon" style="background:rgba(108,99,255,0.15);">📝</div>
            <h3>Temel Bilgiler</h3>
          </div>
          <div class="card-body">
            <div class="form-group">
              <label class="form-label">Etkinlik Adı <span class="required">*</span></label>
              <input type="text" name="title" class="form-control" placeholder="Örn: Türkçe Konuşma Pratiği" maxlength="200" required>
            </div>
            <div class="form-group">
              <label class="form-label">Açıklama <span class="required">*</span></label>
              <textarea name="description" class="form-control" placeholder="Katılımcılar ne yapacak, ne öğrenecek?" required></textarea>
            </div>
            <div class="form-group">
              <label class="form-label">Konum <span class="required">*</span></label>
              <input type="text" name="location" class="form-control" placeholder="Merkez Ofis veya Online - Zoom" maxlength="200" required>
            </div>
          </div>
        </div>

        <div class="card">
          <div class="card-header">
            <div class="card-header-icon" style="background:rgba(34,197,94,0.12);">👥</div>
            <h3>Etkinlik Detayları</h3>
          </div>
          <div class="card-body">
            <div class="form-group">
              <label class="form-label">Ekip <span class="required">*</span></label>
              <select name="team_id" class="form-control" required>
                <option value="">— Ekip Seçin —</option>
                <% led_teams.forEach(team => { %>
                <option value="<%= team.id %>"><%= team.name %></option>
                <% }); %>
              </select>
              <span class="form-hint">Etkinliği yönetecek ekip</span>
            </div>
            <div class="form-group">
              <label class="form-label">Kontenjan <span class="required">*</span></label>
              <input type="number" name="capacity" id="capacityInput" class="form-control" min="1" max="500" value="20" required oninput="updateCapacity()">
              <div class="capacity-preview" id="capacityPreview">
                <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                Maksimum <strong id="capText">20</strong> katılımcı
              </div>
            </div>
          </div>
        </div>

      </div>

      <!-- SAĞ KOLON: Tarih & Saat -->
      <div style="display:flex; flex-direction:column; gap:20px;">

        <div class="card">
          <div class="card-header">
            <div class="card-header-icon" style="background:rgba(234,179,8,0.12);">📅</div>
            <h3>Tarih & Saat</h3>
          </div>
          <div class="card-body">
            <div class="form-group">
              <label class="form-label">Tarih <span class="required">*</span></label>
              <input type="date" name="event_date" id="eventDate" class="form-control" required>
              <span class="form-hint">Gelecek haftanın Pazartesi–Pazar aralığında olmalı</span>
            </div>

            <div class="form-group">
              <label class="form-label">Saat Aralığı <span class="required">*</span></label>
              <div class="time-row">
                <div>
                  <div class="form-label" style="margin-bottom:6px; font-size:11px;">Başlangıç</div>
                  <input type="time" name="start_time" id="startTime" class="form-control" value="14:00" required>
                </div>
                <div>
                  <div class="form-label" style="margin-bottom:6px; font-size:11px;">Bitiş</div>
                  <input type="time" name="end_time" id="endTime" class="form-control" value="15:00" required>
                </div>
              </div>
              <span class="form-hint">Bitiş saati başlangıçtan sonra olmalı</span>
            </div>

            <!-- Deadline info -->
            <div style="padding:14px;background:rgba(234,179,8,0.06);border:1px solid rgba(234,179,8,0.15);border-radius:9px;">
              <div style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.5px;color:#eab308;margin-bottom:6px;">Kayıt Deadline</div>
              <div style="font-size:13px;color:var(--text);" id="deadlineText">Hesaplanıyor...</div>
              <div style="font-size:12px;color:var(--muted);margin-top:4px;">Bu Pazar gece 23:59'da kapanır</div>
            </div>
          </div>
        </div>

        <!-- Özet -->
        <div class="card" id="summaryCard">
          <div class="card-header">
            <div class="card-header-icon" style="background:rgba(6,182,212,0.12);">✓</div>
            <h3>Özet</h3>
          </div>
          <div class="card-body" style="gap:10px;">
            <div style="display:flex;flex-direction:column;gap:8px;font-size:13px;">
              <div style="display:flex;justify-content:space-between;padding-bottom:8px;border-bottom:1px solid var(--border);">
                <span style="color:var(--muted);">Tarih</span>
                <span id="sum-date" style="font-weight:500;">—</span>
              </div>
              <div style="display:flex;justify-content:space-between;padding-bottom:8px;border-bottom:1px solid var(--border);">
                <span style="color:var(--muted);">Saat</span>
                <span id="sum-time" style="font-weight:500;font-family:'DM Mono',monospace;">—</span>
              </div>
              <div style="display:flex;justify-content:space-between;">
                <span style="color:var(--muted);">Kontenjan</span>
                <span id="sum-cap" style="font-weight:500;">20 kişi</span>
              </div>
            </div>
          </div>
        </div>

      </div>

      <!-- SUBMIT ROW: tam genişlik -->
      <div class="submit-row">
        <span class="submit-hint">* zorunlu alanlar</span>
        <a href="/dashboard" class="btn btn-ghost">İptal</a>
        <button type="submit" class="btn btn-primary">
          <svg width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
          Etkinlik Oluştur
        </button>
      </div>

    </div>
  </form>
</div>

<script>
  // Minimum date: gelecek haftanın Pazartesi
  const today = new Date();
  today.setHours(12,0,0,0);
  const day = today.getDay();
  const daysUntilNextMonday = day === 0 ? 1 : (8 - day);
  const nextMonday = new Date(today);
  nextMonday.setDate(today.getDate() + daysUntilNextMonday);
  const nextSunday = new Date(nextMonday);
  nextSunday.setDate(nextMonday.getDate() + 6);

  const toDateStr = (d) => {
    const y = d.getFullYear();
    const m = String(d.getMonth()+1).padStart(2,'0');
    const dd = String(d.getDate()).padStart(2,'0');
    return `${y}-${m}-${dd}`;
  };

  const dateInput = document.getElementById('eventDate');
  dateInput.min = toDateStr(nextMonday);
  dateInput.max = toDateStr(nextSunday);
  dateInput.value = toDateStr(nextMonday);

  // Deadline hesapla
  const daysUntilThisSunday = day === 0 ? 0 : (7 - day);
  const thisSunday = new Date(today);
  thisSunday.setDate(today.getDate() + daysUntilThisSunday);
  document.getElementById('deadlineText').textContent =
    thisSunday.toLocaleDateString('tr-TR', { weekday:'long', day:'numeric', month:'long' }) + ' 23:59';

  // Özet güncelle
  function updateSummary() {
    const d = dateInput.value;
    const s = document.getElementById('startTime').value;
    const e = document.getElementById('endTime').value;
    const c = document.getElementById('capacityInput').value;

    if (d) {
      const dt = new Date(d + 'T12:00:00');
      document.getElementById('sum-date').textContent =
        dt.toLocaleDateString('tr-TR', { weekday:'short', day:'numeric', month:'short' });
    }
    if (s && e) document.getElementById('sum-time').textContent = `${s} – ${e}`;
    document.getElementById('sum-cap').textContent = (c || 20) + ' kişi';
  }

  function updateCapacity() {
    const c = document.getElementById('capacityInput').value;
    document.getElementById('capText').textContent = c || 20;
    updateSummary();
  }

  dateInput.addEventListener('input', updateSummary);
  document.getElementById('startTime').addEventListener('change', updateSummary);
  document.getElementById('endTime').addEventListener('change', updateSummary);
  updateSummary();

  // Validate
  document.getElementById('eventForm').addEventListener('submit', (e) => {
    const s = document.getElementById('startTime').value;
    const end = document.getElementById('endTime').value;
    if (s && end && s >= end) {
      alert('Bitiş saati başlangıç saatinden sonra olmalı');
      e.preventDefault();
    }
  });
</script>
</body>
</html>
