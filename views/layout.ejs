<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" href="/img/site/favicon.ico" type="image/x-icon">
    <link rel="manifest" href="/manifest.webmanifest">
    <meta name="theme-color" content="#0f172a">
    <link rel="apple-touch-icon" href="/img/site/pwa-192.png">
    <title><%- typeof title !== 'undefined' ? title : 'Sitoded Erzurum - Anket Sistemi' %></title>
    <link href="/vendor/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/vendor/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .navbar {
            background: rgba(15, 23, 42, 0.6) !important;
            backdrop-filter: blur(12px) !important;
            border-bottom: 1px solid rgba(99, 102, 241, 0.15) !important;
        }

        .navbar-brand {
            font-size: 1.4rem;
            background: var(--hero-grad);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .nav-link {
            color: #cbd5e1 !important;
            transition: all 0.3s ease;
            margin: 0 0.25rem;
        }

        .nav-link:hover {
            color: var(--accent) !important;
        }

        .dropdown-menu {
            background: rgba(15, 23, 42, 0.95) !important;
            border: 1px solid rgba(99, 102, 241, 0.25) !important;
            backdrop-filter: blur(12px);
        }

        .dropdown-item {
            color: #cbd5e1 !important;
            transition: all 0.2s ease;
        }

        .dropdown-item:hover {
            background: rgba(99, 102, 241, 0.15) !important;
            color: var(--accent) !important;
        }

        .dropdown-divider {
            border-color: rgba(99, 102, 241, 0.2) !important;
        }

        .dropdown-item-text {
            color: #94a3b8 !important;
        }

        @media (max-width: 576px) {
            .navbar {
                padding-top: 0.35rem;
                padding-bottom: 0.35rem;
            }
            .navbar .container-fluid {
                padding-left: 0.75rem !important;
                padding-right: 0.75rem !important;
            }
            .navbar-brand {
                font-size: 1.15rem;
            }
            .nav-link {
                font-size: 0.9rem;
                padding: 0.5rem 0.75rem;
            }
            .dropdown-menu {
                font-size: 0.9rem;
                min-width: 180px;
            }
        }
    </style>
<link rel="stylesheet" href="/css/theme.css?v=20260921"><link rel="stylesheet" href="/css/platform.css?v=20260921"><link rel="stylesheet" href="/css/workspace.css?v=20260921"><script defer src="/js/workspace.js?v=20260921"></script></head>
<body class="workspace ws-layout" data-theme="light">
    <nav class="navbar navbar-expand-lg navbar-dark">
        <div class="container-fluid px-4">
            <button type="button" class="btn btn-sm btn-outline-light me-2 app-back-btn" onclick="history.back()" aria-label="Geri dön" title="Geri">
                <i class="bi bi-arrow-left"></i> Geri
            </button>
            <a class="navbar-brand fw-bold" href="<%- typeof user !== 'undefined' && user ? '/dashboard' : '/login' %>">
                <i class="bi bi-calendar2-event"></i> Sitoded
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <% if (typeof user !== 'undefined' && user) { %>
                        <li class="nav-item">
                            <a class="nav-link" href="/"><i class="bi bi-house"></i> Site</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/dashboard"><i class="bi bi-calendar"></i> Etkinlikler</a>
                        </li>
                        <% if (['SENIOR', 'ADMIN'].includes(user.role)) { %>
                        <li class="nav-item">
                            <a class="nav-link" href="/events/create"><i class="bi bi-plus-circle"></i> Etkinlik Oluştur</a>
                        </li>
                        <% } %>
                        <% if (user.role === 'ADMIN') { %>
                        <li class="nav-item">
                            <a class="nav-link" href="/admin"><i class="bi bi-gear"></i> Yönetim Paneli</a>
                        </li>
                        <% } %>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown">
                                <i class="bi bi-person-circle"></i> <%- user.full_name %>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                                <li><span class="dropdown-item-text"><%- user.hierarchy_level %></span></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" href="/profile"><i class="bi bi-person-gear"></i> Profil & Şifre</a></li>
                                <li><a class="dropdown-item" href="/logout"><i class="bi bi-box-arrow-right"></i> Çıkış Yap</a></li>
                            </ul>
                        </li>
                    <% } %>
                </ul>
            </div>
        </div>
    </nav>

    <main>
        <% if (typeof message !== 'undefined' && message) { %>
            <div class="container-fluid px-4 pt-4">
                <div class="alert alert-info alert-dismissible fade show" role="alert">
                    <%- message %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            </div>
        <% } %>

        <% if (typeof error !== 'undefined' && error) { %>
            <div class="container-fluid px-4 pt-4">
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <%- error %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            </div>
        <% } %>

        <%- body %>
    </main>

    <footer class="bg-dark text-white text-center border-top border-secondary">
        <p class="mb-0 py-4">&copy; 2026 Sitoded Erzurum. Tüm hakları saklıdır.</p>
    </footer>

    <script src="/vendor/bootstrap.bundle.min.js"></script>
    <script>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', function () {
          navigator.serviceWorker.register('/sw.js').catch(function () {});
        });
      }
    </script>
</body>
</html>
