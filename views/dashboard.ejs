<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/css/theme.css?v=20260921">
  <title>Dashboard - Sitoded</title>
  <link rel="icon" href="/img/site/favicon.ico" type="image/x-icon">

  <link rel="stylesheet" href="/vendor/fonts.css">
  <style>
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: 'DM Sans', sans-serif; background: var(--bg); color: var(--text); min-height: 100vh; }
    .topbar { height: 60px; background: var(--surface); border-bottom: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between; padding: 0 24px; position: sticky; top: 0; z-index: 100; }
    .topbar-brand {
  display: flex;
  align-items: center;
}
.topbar-logo {
  height: 44px;
  width: auto;
  display: block;
}
    .topbar-brand img { height: 44px; }
    .topbar-right { display: flex; align-items: center; gap: 10px; }
    .points-chip { display: flex; align-items: center; gap: 5px; padding: 5px 12px; border-radius: 20px; background: rgba(34,197,94,0.1); border: 1px solid rgba(34,197,94,0.2); font-size: 14px; font-weight: 700; color: var(--green); font-family: 'DM Mono', monospace; }
    .user-lbl { font-size: 13px; color: var(--muted); }
    .tbtn { padding: 7px 13px; border-radius: 7px; font-size: 13px; font-weight: 600; font-family: 'DM Sans', sans-serif; cursor: pointer; border: 1px solid; text-decoration: none; transition: all .15s; white-space: nowrap; }
    /* Responsive visibility — Bootstrap not loaded on dashboard */
    .show-mobile { display: none !important; }
    .show-desktop { display: inline !important; }
@media (max-width: 768px) {
  .topbar { padding: 0 8px; height: 48px; }
  .topbar-logo { height: 30px !important; }
  .topbar-brand img { height: 30px !important; }
  .topbar-right { gap: 3px; }
  .tbtn { padding: 5px 6px; font-size: 12px; min-width: 26px; text-align: center; }
  .user-lbl { display: none; }
  .points-chip { font-size: 10px; padding: 3px 6px; }
  .show-mobile { display: inline !important; }
  .show-desktop { display: none !important; }
  .layout { grid-template-columns: 1fr; }
  .main { padding: 14px; border-right: none; }
  .sidebar { display: none; }
}
    .tbtn-admin { background: rgba(234,179,8,.12); color: var(--yellow); border-color: rgba(234,179,8,.2); }
    .tbtn-admin:hover { background: rgba(234,179,8,.22); }
    .tbtn-logout { background: rgba(239,68,68,.1); color: var(--red); border-color: rgba(239,68,68,.2); }
    .tbtn-logout:hover { background: rgba(239,68,68,.2); }
    .tbtn-create { background: var(--accent); color: var(--on-accent); border-color: transparent; }
    .tbtn-create:hover { background: var(--accent2); }
    .layout { display: grid; grid-template-columns: minmax(0, 1fr) 520px; min-height: calc(100vh - 60px); }
    .main { min-width: 0; padding: 24px; border-right: 1px solid var(--border); }
    .main-head { display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 20px; }
    .main-head h1 { font-size: 21px; font-weight: 700; letter-spacing: -.3px; }
    .main-head p { font-size: 12px; color: var(--muted); margin-top: 3px; }
    .search-row { display: flex; gap: 10px; margin-bottom: 18px; }
    .search-wrap { flex: 1; position: relative; }
    .search-wrap svg { position: absolute; left: 11px; top: 50%; transform: translateY(-50%); width: 14px; height: 14px; color: var(--muted); }
    .sinput { width: 100%; background: var(--surface); border: 1px solid var(--border2); border-radius: 8px; padding: 9px 14px 9px 34px; font-size: 13px; color: var(--text); font-family: inherit; outline: none; transition: border-color .15s; }
    .sinput:focus { border-color: var(--accent); }
    .sinput::placeholder { color: var(--muted); }
    .events-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 12px; }
    .ecard { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; overflow: hidden; transition: transform .15s, border-color .15s; }
    .ecard:hover { transform: translateY(-2px); border-color: var(--border2); }
    .ecard-top { padding: 14px 15px 0; }
    .ecard-badges { display: flex; align-items: center; justify-content: space-between; margin-bottom: 9px; }
    .tbadge { font-size: 10px; font-weight: 700; letter-spacing: .5px; text-transform: uppercase; padding: 3px 7px; border-radius: 4px; background: color-mix(in srgb, var(--accent) 12%, transparent); color: var(--accent2); border: 1px solid color-mix(in srgb, var(--accent) 18%, transparent); }
    .sbadge { font-size: 10px; font-weight: 700; padding: 3px 7px; border-radius: 4px; background: rgba(34,197,94,.12); color: var(--green); border: 1px solid rgba(34,197,94,.18); }
    .etitle { font-size: 14px; font-weight: 600; line-height: 1.35; margin-bottom: 9px; }
    .emeta { display: flex; flex-direction: column; gap: 4px; margin-bottom: 10px; }
    .emeta-row { display: flex; align-items: center; gap: 6px; font-size: 12px; color: var(--muted); }
    .ecap { padding: 8px 15px; border-top: 1px solid var(--border); display: flex; align-items: center; gap: 8px; }
    .ecap-bar { flex: 1; height: 3px; background: var(--surface2); border-radius: 2px; overflow: hidden; }
    .ecap-fill { height: 100%; background: var(--accent); border-radius: 2px; transition: width .3s; }
    .ecap-fill.over { background: var(--yellow); }
    .ecap-txt { font-size: 11px; font-family: 'DM Mono', monospace; color: var(--muted); }
    .ecap-txt.over { color: var(--yellow); }
    .eactions { padding: 8px 15px 13px; display: flex; gap: 7px; }
    .abtn { flex: 1; padding: 8px; border-radius: 7px; font-size: 12px; font-weight: 600; font-family: inherit; border: none; cursor: pointer; text-align: center; text-decoration: none; display: block; transition: all .15s; }
    .abtn-join { background: var(--accent); color: var(--on-accent); }
    .abtn-join:hover { background: var(--accent2); }
    .abtn-leave { background: rgba(239,68,68,.1); color: var(--red); border: 1px solid rgba(239,68,68,.18); }
    .abtn-leave:hover { background: rgba(239,68,68,.2); }
    .abtn-att { background: var(--surface2); color: var(--muted); border: 1px solid var(--border2); }
    .abtn-att:hover { color: var(--text); background: var(--border); }
    .empty { grid-column: 1/-1; text-align: center; padding: 60px; color: var(--muted); font-size: 14px; }
    .spinner { width: 30px; height: 30px; border: 3px solid var(--border2); border-top-color: var(--accent); border-radius: 50%; animation: spin .8s linear infinite; margin: 50px auto; }
    @keyframes spin { to { transform: rotate(360deg); } }
    .sidebar { min-width: 0; background: var(--surface); overflow-y: auto; overflow-x: hidden; position: sticky; top: 60px; max-height: calc(100vh - 60px); }
    .sidebar-head { padding: 16px 18px 10px; border-bottom: 1px solid var(--border); font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .8px; color: var(--muted); }
    /* 2 kolonlu haftalık grid */
    .week-grid { display: grid; grid-template-columns: 1fr; border-top: 1px solid var(--border); }
    .wday { border-bottom: 1px solid var(--border); padding: 10px 12px 10px; min-height: 80px; }
    .wday-header { display: flex; align-items: center; gap: 7px; margin-bottom: 6px; }
    .wday-full { grid-column: 1 / -1; border-right: none; }
    .dlabel { font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: .5px; color: var(--muted); }
    .dnum { font-size: 15px; font-weight: 700; color: var(--text); font-family: 'DM Mono', monospace; width: 26px; height: 26px; display: flex; align-items: center; justify-content: center; border-radius: 50%; }
    .dnum.today { background: var(--accent); color: var(--on-accent); }
    .devents { display: flex; flex-direction: column; gap: 3px; }
    .drow { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
    .drow.drow-overlap, .ws-dashboard .drow.drow-overlap { padding-left: 6px; border-left: 2px dashed #d7a64a; }
    .drow-label { font-size: 10px; font-weight: 600; color: #8a6a1f; }
    .cev { flex: 1; min-width: 0; padding: 4px 6px; border-radius: 5px; font-size: 11px; line-height: 1.3; border-left: 2px solid; }
    .cev.none { background: color-mix(in srgb, var(--accent) 8%, transparent); border-left-color: var(--accent); color: var(--accent2); }
    .cev.joined { background: rgba(34,197,94,.1); border-left-color: var(--green); color: var(--green); }
    .cev-time { font-family: 'DM Mono', monospace; font-size: 10px; opacity: .8; }
    .cev-title { font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .dempty { font-size: 11px; color: var(--muted); padding-top: 2px; }
    #toasts { position: fixed; top: 18px; right: 18px; z-index: 9999; display: flex; flex-direction: column; gap: 7px; }
    .toast { display: flex; align-items: center; gap: 9px; padding: 11px 15px; border-radius: 8px; font-size: 13px; font-weight: 500; min-width: 240px; border: 1px solid; animation: tIn .2s ease; }
    .toast.success { background: rgba(22,101,52,.95); color: var(--green); border-color: rgba(34,197,94,.3); }
    .toast.error { background: rgba(127,29,29,.95); color: var(--red); border-color: rgba(239,68,68,.3); }
    .toast.info { background: rgba(30,58,138,.95); color: #93c5fd; border-color: rgba(59,130,246,.3); }
    .modal-backdrop { position: fixed; inset: 0; background: rgba(0,0,0,.55); display: none; align-items: center; justify-content: center; z-index: 10000; }
    .modal-backdrop.show { display: flex; }
    .modal { background: var(--surface); border: 1px solid var(--border2); border-radius: 12px; width: min(680px, 95vw); max-height: calc(100vh - 100px); overflow: auto; padding: 20px; }
    .modal h3 { margin-bottom: 10px; font-size: 18px; }
    .modal p { margin-bottom: 14px; color: var(--muted); line-height: 1.4; }
    .modal-small { font-size: 13px; margin-bottom: 12px; }
    .modal-actions { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-top: 14px; }
    .modal-actions .btn { padding: 8px 12px; border-radius: 7px; border: 1px solid var(--border2); background: var(--surface2); color: var(--text); cursor: pointer; }
    .modal-actions .btn-primary { background: var(--accent); border-color: transparent; color: white; }
    @keyframes tIn { from { transform: translateX(110%); opacity: 0; } to { transform: translateX(0); opacity: 1; } }
    @media (max-width: 1024px) { .layout { grid-template-columns: 1fr; } .sidebar { position: static; height: auto; } }
  </style>
  <script src="/js/theme.js?v=20260921"></script>
  <link rel="stylesheet" href="/css/platform.css?v=20260921">
<link rel="stylesheet" href="/css/workspace.css?v=20260921"><script defer src="/js/workspace.js?v=20260921"></script></head>
<body data-theme="light" class="workspace ws-dashboard">

<header class="topbar">
<a class="topbar-brand" href="/"><%- include('public/brand') %></a>
  <div class="topbar-right">
    <span class="user-lbl" id="uname"></span>
    <div class="points-chip">&#9733; <span id="upts">0</span></div>
    <% if (user.role === 'SENIOR' || user.role === 'ADMIN') { %>
    <a href="/events/create" class="tbtn tbtn-create"><span class="show-mobile">+</span><span class="show-desktop">+ Etkinlik</span></a>
    <% } %>
    <% if (user.role === 'SENIOR') { %>
    <button onclick="openAttendanceModal()" aria-label="Yoklama al" class="tbtn" style="background: rgba(34,197,94,.12); color: var(--green); border-color: rgba(34,197,94,.2);"><span class="show-mobile"><%- include('shared/icon', {name:'check'}) %></span><span class="show-desktop"> Yoklama Al</span></button>
    <% } %>
    <% if (user.role === 'ADMIN') { %>
    <a href="/admin" class="tbtn tbtn-admin"><span class="show-mobile"><%- include('shared/icon', {name:'chart'}) %></span><span class="show-desktop"> Yönetim</span></a>
    <% } %>
    <a href="/logout" class="tbtn tbtn-logout"><span class="show-mobile">↪</span><span class="show-desktop">Çıkış</span></a>
  </div>
</header>

<div class="layout">
  <main class="main"><section class="workspace-welcome"><div><span class="workspace-eyebrow">SİTODED / GÖNÜLLÜ TOPLULUĞU</span><h1>Merhaba, <%= user.full_name.split(' ')[0] %>.</h1><p>Birlikte öğrenmek, paylaşmak ve katkı sunmak için buradayız.</p><a class="workspace-text-link" href="/profile">Profilimi düzenle <span>↗</span></a></div><img src="/img/editorial/cycling-640.webp" width="300" height="200" alt=""></section>
    <div class="main-head">
      <div>
        <h2>Etkinlikler</h2>
        <p>Gelecek hafta &mdash; başvurular Pazar günü 12:00 veya 19:00'da otomatik açılır (5 saat)</p>
      </div>
    </div>
    <div id="profile-banner" style="display:none;"></div>
    <div class="tabs" style="display:flex; gap:6px; margin-bottom:12px;">
      <button id="tab-events" class="tbtn" style="background: var(--accent-soft); color: var(--accent); border-color: var(--accent);" onclick="switchTab('events')">Etkinlikler</button>
      <button id="tab-mine" class="tbtn" onclick="switchTab('mine')"> Etkinliklerim</button>
    </div>
    <div class="search-row" id="search-row">
      <div class="search-wrap">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
        <input type="text" class="sinput" placeholder="Etkinlik, ekip veya konum..." id="search" oninput="filterEvts()">
      </div>
    </div>
    <div id="eval-notices" style="display:none; flex-direction:column; gap:8px; margin-bottom:14px;"></div>
    <div class="events-grid" id="grid"><div class="spinner"></div></div>
    <div id="myevents" style="display:none; flex-direction:column; gap:10px;"></div>

    <!-- Şikayet & Öneri -->
    <div class="fb-card" style="margin-top:22px; background:var(--surface); border:1px solid var(--border); border-radius:12px; padding:16px;">
      <div style="display:flex; align-items:center; gap:8px; margin-bottom:10px;">
        <%- include('shared/icon',{name:'dialog'}).trim() %>
        <strong style="font-size:14px;">Şikayet &amp; Öneri</strong>
        <span style="font-size:12px; color:var(--muted);">Görüşlerinizi yönetim ekibiyle paylaşın</span>
      </div>
      <div style="display:flex; gap:8px; margin-bottom:8px;">
        <select id="fb-kind" style="background:var(--surface2); color:var(--text); border:1px solid var(--border2); border-radius:8px; padding:8px 10px; font-family:inherit; font-size:13px;">
          <option value="ONERI"> Öneri</option>
          <option value="SIKAYET"> Şikayet</option>
        </select>
      </div>
      <textarea id="fb-message" rows="3" maxlength="3000" placeholder="Ne düşünüyorsun? (en az 5 karakter)" style="width:100%; background:var(--surface2); color:var(--text); border:1px solid var(--border2); border-radius:8px; padding:10px 12px; font-family:inherit; font-size:13px; resize:vertical;"></textarea>
      <button class="tbtn" style="margin-top:8px; background:var(--accent); color:var(--on-accent); border-color:transparent;" onclick="sendFeedback()">Gönder</button>
    </div>
  </main>

  <aside class="sidebar">
    <div class="sidebar-head">Bu Hafta</div>
    <div id="cal"></div>
  </aside>
</div>

<div id="event-modal" class="modal-backdrop">
  <div class="modal">
    <h3 id="modal-title">Etkinlik detay</h3>
    <p class="modal-small" id="modal-meta"></p>
    <p id="modal-description"></p>
    <input type="hidden" id="modal-event-id" value="" />
    <label style="display:flex;gap:8px;align-items:center;margin-bottom:10px;"><input type="checkbox" id="modal-confirm"> Okudum ve onaylıyorum</label>
    <div class="modal-actions">
      <button class="btn" onclick="closeModal()">İptal</button>
      <button id="modal-join-btn" class="btn btn-primary" onclick="confirmJoin()" disabled>Katıl</button>
    </div>
  </div>
</div>

<div id="attendance-modal" class="modal-backdrop">
  <div class="modal">
    <h3>Yoklama Al</h3>
    <p style="color: var(--muted); font-size: 13px; margin-bottom: 15px;">Geçmiş etkinliklerinizden birini seçin</p>
    <div id="attendance-list" style="max-height: 400px; overflow-y: auto; border: 1px solid var(--border); border-radius: 6px;"></div>
    <div class="modal-actions" style="margin-top: 15px;">
      <button class="btn" onclick="closeAttendanceModal()">İptal</button>
    </div>
  </div>
</div>

<div id="toasts"></div>

<script>
  let allEvts = [], regs = {};
  let pendingJoinId = null;
  let nextOpening = null;
  const role = '<%= user.role %>';

  document.addEventListener('DOMContentLoaded', load);
  document.addEventListener('DOMContentLoaded', loadNotices);
  document.addEventListener('DOMContentLoaded', loadProfileStatus);

  // ===== PROFİL TAMAMLAMA BANNERI =====
  async function loadProfileStatus() {
    try {
      const res = await fetch('/api/user/profile-status');
      const data = await res.json();
      if (!data.success || data.completed) return;
      const box = document.getElementById('profile-banner');
      box.style.display = '';
      box.innerHTML = '<a href="/profile" style="display:flex;align-items:center;gap:10px;padding:12px 14px;margin-bottom:14px;background:rgba(234,179,8,.12);border:1px solid rgba(234,179,8,.35);border-radius:10px;text-decoration:none;color:var(--text);font-size:13px;">' +
        '<%- include('shared/icon',{name:'dialog'}).trim() %>' +
        '<span><strong>Profilini tamamla</strong><br><span style="color:var(--muted);font-size:12px;">İletişim, ilgi alanları ve pasaport bilgilerinle etkinliklere hazır ol — 2 dakika sürer</span></span>' +
        '<span style="margin-left:auto;color:var(--accent2);">Doldur →</span></a>';
    } catch (e) { /* sessizce geç */ }
  }

  // ===== ETKİNLİKLERİM SEKMESİ =====
  let myEventsLoaded = false;
  function switchTab(tab) {
    const evBtn = document.getElementById('tab-events');
    const myBtn = document.getElementById('tab-mine');
    const grid = document.getElementById('grid');
    const mine = document.getElementById('myevents');
    const search = document.getElementById('search-row');
    const notices = document.getElementById('eval-notices');
    if (tab === 'mine') {
      evBtn.style.cssText = '';
      myBtn.style.cssText = 'background: var(--accent-soft); color: var(--accent); border-color: var(--accent);';
      grid.style.display = 'none'; search.style.display = 'none'; notices.style.display = 'none';
      mine.style.display = 'flex';
      if (!myEventsLoaded) { myEventsLoaded = true; loadMyEvents(); }
    } else {
      myBtn.style.cssText = '';
      evBtn.style.cssText = 'background: var(--accent-soft); color: var(--accent); border-color: var(--accent);';
      grid.style.display = ''; search.style.display = ''; notices.style.display = '';
      mine.style.display = 'none';
    }
  }

  async function loadMyEvents() {
    const box = document.getElementById('myevents');
    try {
      const res = await fetch('/api/user/my-events');
      const data = await res.json();
      if (!data.success) { box.innerHTML = '<p style="color:var(--muted);font-size:13px;">Yüklenemedi</p>'; return; }
      if (!data.data.length) {
        box.innerHTML = '<p style="color:var(--muted);font-size:13px;padding:20px;text-align:center;">Henüz katıldığın etkinlik yok. Etkinlikler sekmesinden başvuru yapabilirsin.</p>';
        return;
      }
      const now = new Date();
      box.innerHTML = data.data.map(e => {
        const evDate = new Date(e.event_date + 'T00:00:00');
        const past = evDate < now;
        const badge = e.event_status === 'CANCELLED' || e.reg_status === 'CANCELLED'
          ? '<span class="badge">İptal edildi</span>'
          : e.reg_status === 'NO_SHOW' ? '<span class="badge">Katılmadı</span>'
          : e.reg_status === 'CONFIRMED'
          ? '<span style="font-size:11px;font-weight:600;padding:3px 8px;border-radius:6px;background:rgba(34,197,94,.12);color:var(--green);border:1px solid rgba(34,197,94,.25);">Onaylı</span>'
          : '<span style="font-size:11px;font-weight:600;padding:3px 8px;border-radius:6px;background:rgba(234,179,8,.12);color:var(--yellow);border:1px solid rgba(234,179,8,.25);">Beklemede' + (e.queue_position ? ' #' + e.queue_position : '') + '</span>';
        const att = past
          ? (e.attended === true ? '<span style="font-size:11px;color:var(--green);">✓ Katıldın</span>'
            : e.attended === false ? '<span style="font-size:11px;color:var(--red);">✗ Katılmadın</span>'
            : '<span style="font-size:11px;color:var(--muted);">—</span>')
          : '';
        const d = evDate.toLocaleDateString('tr-TR', { day: 'numeric', month: 'short', year: 'numeric' });
        return '<div style="display:flex;align-items:center;gap:10px;padding:12px 14px;background:var(--surface);border:1px solid var(--border);border-radius:10px;">' +
          '<div style="flex:1;min-width:0;">' +
            '<div style="font-size:13px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">' + e.title + '</div>' +
            '<div style="font-size:11px;color:var(--muted);font-family:\'DM Mono\',monospace;">' + d + ' · ' + String(e.start_time).substring(0,5) + ' · ' + e.team_name + '</div>' +
          '</div>' + att + badge +
        '</div>';
      }).join('');
    } catch (e) {
      box.innerHTML = '<p style="color:var(--muted);font-size:13px;">Yüklenemedi</p>';
    }
  }

  // ===== ŞİKAYET & ÖNERİ =====
  async function sendFeedback() {
    const kind = document.getElementById('fb-kind').value;
    const message = document.getElementById('fb-message').value.trim();
    if (message.length < 5) { toast('Mesaj en az 5 karakter olmalı', 'error'); return; }
    try {
      const res = await fetch('/api/user/feedback', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ kind, message })
      });
      const data = await res.json();
      if (data.success) {
        toast(data.message, 'success');
        document.getElementById('fb-message').value = '';
      } else {
        toast(data.error, 'error');
      }
    } catch (e) {
      toast('Hata: ' + e.message, 'error');
    }
  }

  // Katıldığım etkinliklerin açık değerlendirme anketleri
  async function loadNotices() {
    const box = document.getElementById('eval-notices');
    try {
      const res = await fetch('/api/user/evaluation-notices');
      const data = await res.json();
      if (!data.success || !data.data.length) return;
      box.style.display = 'flex';
      box.innerHTML = data.data.map(s => {
        return '<a href="/a/' + encodeURIComponent(s.slug) + '" style="display:flex;align-items:center;gap:10px;padding:12px 14px;background:color-mix(in srgb, var(--accent) 10%, transparent);border:1px solid color-mix(in srgb, var(--accent) 30%, transparent);border-radius:10px;text-decoration:none;color:var(--text);font-size:13px;">' +
          '<%- include('shared/icon',{name:'dialog'}).trim() %>' +
          '<span><strong>' + s.title + '</strong><br><span style="color:var(--muted);font-size:12px;">Katıldığın "' + s.event_title + '" etkinliği için — doldurmak 2 dakika sürer</span></span>' +
          '<span style="margin-left:auto;color:var(--accent2);">Doldur →</span>' +
        '</a>';
      }).join('');
    } catch (e) { /* sessizce geç */ }
  }

  function openModal(eventId) {
    var evt = allEvts.find(function(x) { return x.id === eventId; });
    if (!evt) return;
    pendingJoinId = eventId;
    document.getElementById('modal-event-id').value = eventId;
    document.getElementById('modal-title').textContent = evt.title;
    document.getElementById('modal-meta').textContent = evt.team + ' • ' + evt.location + ' • ' + evt.event_date + ' ' + evt.start_time + '-' + evt.end_time;
    document.getElementById('modal-description').textContent = evt.description;
    document.getElementById('modal-confirm').checked = false;
    document.getElementById('modal-join-btn').disabled = true;
    document.getElementById('event-modal').classList.add('show');
  }

  function closeModal() {
    pendingJoinId = null;
    document.getElementById('event-modal').classList.remove('show');
  }

  function confirmJoin() {
    if (!document.getElementById('modal-confirm').checked) return;
    var eventId = pendingJoinId || document.getElementById('modal-event-id').value;
    if (!eventId) {
      toast('Etkinlik id eksik, tekrar deneyin', 'error');
      return;
    }
    closeModal();
    doJoin(eventId);
  }

  document.getElementById('modal-confirm').addEventListener('change', function() {
    document.getElementById('modal-join-btn').disabled = !this.checked;
  });

  async function load() {
    const r = await fetch('/api/dashboard-data');
    const j = await r.json();
    if (!j.success) { toast('Veri yuklenemedi', 'error'); return; }
    const d = j.data;
    document.getElementById('upts').textContent = d.user.points;
    document.getElementById('uname').textContent = d.user.full_name;
    allEvts = d.events;
    nextOpening = d.next_opening || null;
    regs = {};
    d.events.forEach(function(e) { if (e.user_registration) regs[e.id] = e.user_registration; });
    renderEvts(allEvts);
    renderCal(allEvts);
    tickCountdowns();

    // Etkinlik oluşturma sonrası bilgilendirme
    const qp = new URLSearchParams(window.location.search);
    if (qp.get('event_created') === '1' && qp.get('open')) {
      const od = new Date(qp.get('open'));
      toast('Etkinlik oluşturuldu. Başvurular ' + fmtDateLong(od) + ' saat ' + fmtTime(od) + '\'de açılacak, 5 saat açık kalacak.', 'success');
      history.replaceState(null, '', '/dashboard');
    }
  }

  function filterEvts() {
    var query = document.getElementById('search').value.trim().toLowerCase();
    if (!query) { renderEvts(allEvts); return; }

    var days = {
      'pzt': 'pazartesi', 'pazartesi': 'pazartesi',
      'sal': 'sali', 'sali': 'sali',
      'car': 'carsamba', 'çar': 'carsamba', 'çarşamba': 'carsamba', 'carsamba': 'carsamba',
      'per': 'persembe', 'persembe': 'persembe',
      'cum': 'cuma', 'cuma': 'cuma',
      'cmt': 'cumartesi', 'cumartesi': 'cumartesi',
      'paz': 'pazar', 'pazar': 'pazar'
    };

    var norm = query.replace(/[çğıöşü]/g, function(ch){
      return {'ç':'c','ğ':'g','ı':'i','ö':'o','ş':'s','ü':'u'}[ch] || ch;
    });

    renderEvts(allEvts.filter(function(e) {
      var title = e.title.toLowerCase();
      var team = e.team.toLowerCase();
      var loc = e.location.toLowerCase();
      var desc = (e.description||'').toLowerCase();
      var start = e.start_time.toLowerCase();
      var end = e.end_time.toLowerCase();
      var date = e.event_date.toLowerCase();
      var dateObj = new Date(e.event_date + 'T12:00:00');
      var weekdays = ['pazar','pazartesi','sali','carsamba','persembe','cuma','cumartesi'];
      var shortWeek = ['paz','pzt','sal','car','per','cum','cmt'];
      var week = weekdays[dateObj.getDay()];
      var short = shortWeek[dateObj.getDay()];
      var localDate = dateObj.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long', year: 'numeric' }).toLowerCase();
      var localDateShort = dateObj.toLocaleDateString('tr-TR', { day: 'numeric', month: 'short', year: 'numeric' }).toLowerCase();
      var isDay = days[norm];

      if (title.includes(norm) || team.includes(norm) || loc.includes(norm) || desc.includes(norm) || start.includes(norm) || end.includes(norm)) return true;
      if (date.includes(norm) || localDate.includes(norm) || localDateShort.includes(norm)) return true;
      if (week.includes(norm) || short.includes(norm)) return true;
      if (isDay && week === isDay) return true;
      return false;
    }));
  }

  function renderEvts(evts) {
    var g = document.getElementById('grid');
    if (!evts.length) { g.innerHTML = '<div class="empty">' + emptyHtml() + '</div>'; return; }
    g.innerHTML = evts.map(function(e) {
      var reg = regs[e.id];
      var joined = reg && reg.status === 'CONFIRMED';
      var queued = reg && reg.status === 'REGISTERED';
      var cnt = e.confirmed_count;
      var over = cnt > e.capacity;
      var pct = Math.min((cnt / e.capacity) * 100, 100);
      var past = isPast(e.event_date, e.end_time);
      var canAtt = past && (role === 'SENIOR' || role === 'ADMIN');
      var dt = new Date(e.event_date + 'T12:00:00');
      var ds = dt.toLocaleDateString('tr-TR', {weekday:'short', day:'numeric', month:'short'});

      // Durum rozetleri
      var badges = '<span class="tbadge">'+e.team+'</span>';
      if (joined) badges += '<span class="sbadge">Katiliyorum</span>';
      else if (queued) badges += '<span class="sbadge" style="background: rgba(234,179,8,.12); color: var(--yellow); border-color: rgba(234,179,8,.18);">Bekleme listesinde</span>';
      if (e.is_leader) badges += '<span class="sbadge" style="background: rgba(168,85,247,.12); color: #c084fc; border-color: rgba(168,85,247,.18);">Liderim</span>';
      if (e.is_open) badges += '<span class="sbadge" style="background: rgba(6,182,212,.12); color: #67e8f9; border-color: rgba(6,182,212,.18);">Basvurular acik — <span class="ocd" data-close="'+e.registration_deadline+'"></span></span>';
      else if (e.is_leader && !past) {
        if (e.deadline_passed) badges += '<span class="sbadge" style="background: rgba(255,255,255,.05); color: var(--muted); border: 1px solid var(--border);">Basvurular kapandi</span>';
        else if (e.registration_open) badges += '<span class="sbadge" style="background: rgba(234,179,8,.12); color: var(--yellow); border-color: rgba(234,179,8,.18);">Acilis: '+fmtDateShort(new Date(e.registration_open))+' '+fmtTime(new Date(e.registration_open))+'</span>';
      }
      if (canAtt) badges += '<span class="sbadge" style="background: rgba(239,68,68,.12); color: var(--red); border-color: rgba(239,68,68,.18);">Yoklama Alinabilir</span>';

      var btn = '';
      if (canAtt) btn = '<button class="abtn abtn-att" onclick="goToAttendance('+e.id+', \''+e.title.replace(/'/g, '\\\'')+'\')">Yoklama</button>';
      else if (e.is_leader) btn = '<a class="abtn abtn-att" href="/event/'+e.id+'/registrations">Kayıtlar</a>';
      else if (e.is_open && (!reg || reg.status === 'CANCELLED')) btn = '<button class="abtn abtn-join" onclick="openModal('+e.id+')">Katil</button>';
      else if (reg && reg.status !== 'CANCELLED') btn = '<button class="abtn abtn-leave" onclick="doLeave('+e.id+')">Katilma</button>';
      else btn = '<span class="abtn" style="cursor:default;color:var(--muted);border-color:var(--border);">Kapali</span>';

      var shortDesc = e.description ? (e.description.length > 90 ? e.description.substring(0, 90) + '...' : e.description) : '';
      return '<div class="ecard">' +
        '<div class="ecard-top">' +
          '<div class="ecard-badges">'+badges+'</div>' +
          '<div class="etitle">'+e.title+'</div>' +
          (shortDesc ? '<div class="emeta-row" style="font-size:12px;color:var(--muted);margin-bottom:8px;">'+shortDesc+'</div>' : '') +
          '<div class="emeta">' +
            '<div class="emeta-row"><%- include('shared/icon',{name:'calendar'}).trim() %> <span>'+ds+'</span></div>' +
            '<div class="emeta-row">&#9200; <span style="font-family:\'DM Mono\',monospace">'+e.start_time.substring(0,5)+' - '+e.end_time.substring(0,5)+'</span></div>' +
            '<div class="emeta-row"><%- include('shared/icon',{name:'pin'}).trim() %> <span>'+e.location+'</span></div>' +
          '</div>' +
        '</div>' +
        '<div class="ecap"><div class="ecap-bar"><div class="ecap-fill'+(over?' over':'')+'" style="width:'+pct+'%"></div></div>' +
        '<span class="ecap-txt'+(over?' over':'')+'">'+cnt+'/'+e.capacity+(over?' +'+(cnt-e.capacity):'')+'</span></div>' +
        '<div class="eactions">'+btn+'</div>' +
      '</div>';
    }).join('');
  }

  // Boş durum: sonraki açılışa geri sayım
  function emptyHtml() {
    if (!nextOpening) return 'Etkinlik bulunamadi';
    var d = new Date(nextOpening);
    return '<div style="font-size:14px;margin-bottom:6px;">Yeni etkinlik basvurulari <strong style="color:var(--accent2)">' + fmtDateLong(d) + ' saat ' + fmtTime(d) + '</strong>\'de acilacak</div>' +
      '<div style="font-size:12px;">Kalan sure: <strong><span id="cd-remaining" data-open="' + nextOpening + '"></span></strong></div>' +
      '<div style="font-size:12px;margin-top:8px;opacity:.8;">Basvurular 5 saat acik kalir; acilisa kadar etkinlikler gizlidir.</div>';
  }

  function fmtDateShort(d) {
    return d.toLocaleDateString('tr-TR', { weekday: 'short', day: 'numeric', month: 'short' });
  }
  function fmtDateLong(d) {
    return d.toLocaleDateString('tr-TR', { weekday: 'long', day: 'numeric', month: 'long' });
  }
  function fmtTime(d) {
    return d.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' });
  }

  function fmtRemain(ms) {
    var s = Math.floor(ms / 1000);
    var d = Math.floor(s / 86400); s -= d * 86400;
    var h = Math.floor(s / 3600); s -= h * 3600;
    var m = Math.floor(s / 60); s -= m * 60;
    var parts = [];
    if (d) parts.push(d + 'g');
    if (h || d) parts.push(h + 's');
    parts.push(m + 'dk');
    return parts.join(' ');
  }

  function tickCountdowns() {
    var nowMs = Date.now();
    document.querySelectorAll('.ocd').forEach(function(el) {
      var ms = new Date(el.dataset.close).getTime() - nowMs;
      el.textContent = ms > 0 ? (fmtRemain(ms) + ' kaldi') : 'kapandi';
    });
    var cd = document.getElementById('cd-remaining');
    if (cd) {
      var ms = new Date(cd.dataset.open).getTime() - nowMs;
      cd.textContent = ms > 0 ? fmtRemain(ms) : 'birazdan acilacak';
    }
  }
  setInterval(tickCountdowns, 30000);

  function goToAttendance(eventId, eventTitle) {
    if (confirm('"' + eventTitle + '" etkinliğinin yoklama sayfasına gitmek istiyor musunuz?')) {
      window.location.href = '/attendance/' + eventId;
    }
  }

  async function doJoin(id) {
    if (!id) {
      toast('Etkinlik ID eksik. Lütfen tekrar deneyin.', 'error');
      return;
    }
    var r = await fetch('/api/event/'+id+'/register', {method:'POST', headers:{'Content-Type':'application/json'}});
    var d = await r.json();
    toast(d.success ? d.message : d.error, d.success ? 'success' : 'error');
    if (d.success) load();
  }

  async function doLeave(id) {
    if (!confirm('Katilmaktan vazgecmek istediginize emin misiniz?')) return;
    var r = await fetch('/api/event/'+id+'/unregister', {method:'POST', headers:{'Content-Type':'application/json'}});
    var d = await r.json();
    toast(d.success ? d.message + (d.penalty_applied ? ' (-1 puan)' : '') : d.error, d.success ? 'success' : 'error');
    if (d.success) load();
  }

  // Saat string -> dakika cevir
  function toMin(t) {
    var p = t.substring(0,5).split(':');
    return parseInt(p[0]) * 60 + parseInt(p[1]);
  }

  // e icin cakisan bolgenin gradient style'ini hesapla
  function conflictStyle(e, others) {
    var as = toMin(e.start_time), ae = toMin(e.end_time), dur = ae - as;
    if (dur <= 0) return '';
    var ovS = ae, ovE = as;
    others.forEach(function(o) {
      var bs = toMin(o.start_time), be = toMin(o.end_time);
      var cs = Math.max(as, bs), ce = Math.min(ae, be);
      if (ce > cs) { ovS = Math.min(ovS, cs); ovE = Math.max(ovE, ce); }
    });
    if (ovE <= ovS) return '';
    var s = Math.round(((ovS - as) / dur) * 100);
    var en = Math.round(((ovE - as) / dur) * 100);
    var gr = 'rgba(34,197,94,0.1)', rd = 'rgba(239,68,68,0.28)';
    var bg;
    if (s <= 0 && en >= 100) bg = rd;
    else if (s <= 0) bg = 'linear-gradient(to bottom,' + rd + ' ' + en + '%,' + gr + ' ' + en + '%)';
    else if (en >= 100) bg = 'linear-gradient(to bottom,' + gr + ' ' + s + '%,' + rd + ' ' + s + '%)';
    else bg = 'linear-gradient(to bottom,' + gr + ' ' + s + '%,' + rd + ' ' + s + '%,' + rd + ' ' + en + '%,' + gr + ' ' + en + '%)';
    return 'background:' + bg + ';border-left-color:#ef4444;color:var(--red);';
  }

  function renderCal(evts) {
    var c = document.getElementById('cal');
    var today = new Date(); today.setHours(12,0,0,0);
    var dow = today.getDay();
    var daysUntil = dow === 0 ? 1 : (8 - dow);
    var mon = new Date(today); mon.setDate(today.getDate() + daysUntil);
    var DAYS = ['Pzt','Sal','Car','Per','Cum','Cmt','Paz'];
    var html = '';
    for (var i = 0; i < 7; i++) {
      var d = new Date(mon); d.setDate(mon.getDate() + i);
      var ds = lstr(d);
      var isT = lstr(today) === ds;
      var dayEvts = evts.filter(function(e) { return e.event_date === ds; }).sort(function(a,b) { return a.start_time.localeCompare(b.start_time); });
      var groups = groupOverlap(dayEvts);
      var wdayClass = i === 6 ? 'wday wday-full' : 'wday';
      html += '<div class="' + wdayClass + '"><div class="wday-header"><span class="dlabel">' + DAYS[i] + '</span><span class="dnum' + (isT ? ' today' : '') + '">' + d.getDate() + '</span></div>';
      if (!groups.length) {
        html += '<div class="dempty">Etkinlik yok</div>';
      } else {
        html += '<div class="devents">';
        groups.forEach(function(g) {
          var joinedInGroup = g.filter(function(e) { return regs[e.id] && regs[e.id].status === 'CONFIRMED'; });
          html += g.length > 1
            ? '<div class="drow drow-overlap"><div class="drow-label">' + g.length + ' etkinlik çakışıyor</div>'
            : '<div class="drow">';
          g.forEach(function(e) {
            var joined = regs[e.id] && regs[e.id].status === 'CONFIRMED';
            var conflict = joined && joinedInGroup.length > 1;
            var style = '';
            if (conflict) {
              var others = joinedInGroup.filter(function(x) { return x.id !== e.id; });
              style = conflictStyle(e, others);
            }
            var cls = 'cev ' + (joined ? 'joined' : 'none');
            html += '<div class="' + cls + '" style="' + style + '">' +
              '<div class="cev-time">' + e.start_time.substring(0,5) + '-' + e.end_time.substring(0,5) + '</div>' +
              '<div class="cev-title" title="' + escH(e.title) + '">' + escH(e.title) + '</div>' +
            '</div>';
          });
          html += '</div>';
        });
        html += '</div>';
      }
      html += '</div>';
    }
    c.innerHTML = '<div class="week-grid">' + html + '</div>';
  }

  // Başlangıca göre sıralı listede zincirleme çakışanları tek grupta toplar
  function groupOverlap(evts) {
    var groups = [], cur = null, curEnd = '';
    evts.forEach(function(e) {
      if (cur && e.start_time < curEnd) {
        cur.push(e);
        if (e.end_time > curEnd) curEnd = e.end_time;
      } else {
        cur = [e]; curEnd = e.end_time;
        groups.push(cur);
      }
    });
    return groups;
  }

  function escH(s) {
    return String(s == null ? '' : s).replace(/[&<>"']/g, function(c) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
    });
  }

  function lstr(d) {
    return d.getFullYear() + '-' + String(d.getMonth()+1).padStart(2,'0') + '-' + String(d.getDate()).padStart(2,'0');
  }

  function isPast(ds, et) { return new Date() > new Date(ds + 'T' + et); }

  function toast(msg, type) {
    var el = document.createElement('div');
    el.className = 'toast ' + (type || 'info');
    el.textContent = msg;
    document.getElementById('toasts').appendChild(el);
    setTimeout(function() { el.remove(); }, 3500);
  }

  async function openAttendanceModal() {
    try {
      const r = await fetch('/api/admin/attendance-events');
      const d = await r.json();
      if (!d.success) {
        toast('Etkinlikler yüklenemedi', 'error');
        return;
      }
      const events = d.events || [];
      const listEl = document.getElementById('attendance-list');
      if (events.length === 0) {
        listEl.innerHTML = '<div style="padding: 20px; text-align: center; color: var(--muted);">Yoklama alınabilecek etkinlik bulunamadı</div>';
      } else {
        listEl.innerHTML = events.map(e => {
          const eventDate = e.event_date ? e.event_date.trim() : '';
          const startTime = e.start_time ? e.start_time.substring(0, 5) : '--:--';
          const endTime = e.end_time ? e.end_time.substring(0, 5) : '--:--';
          const dt = eventDate ? new Date(eventDate) : null;
          const ds = dt ? dt.toLocaleDateString('tr-TR', { weekday: 'short', year: 'numeric', month: 'long', day: 'numeric' }) : 'Tarih bilinmiyor';
          const regCount = e.registered_count || 0;
          return '<div style="padding: 12px; border-bottom: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center;">' +
            '<div>' +
              '<div style="font-weight: 500; color: var(--text-dark);">' + e.title + '</div>' +
              '<div style="font-size: 12px; color: var(--text-gray);">' + ds + ' • ' + startTime + ' - ' + endTime + ' • ' + regCount + ' kişi</div>' +
            '</div>' +
            '<button class="btn btn-primary" style="padding: 6px 12px; font-size: 13px;" onclick="goToAttendance(' + e.id + ', \'' + e.title.replace(/'/g, "\\'") + '\')">Aç</button>' +
            '</div>';
        }).join('');
      }
      document.getElementById('attendance-modal').classList.add('show');
    } catch (err) {
      console.error(err);
      toast('Hata oluştu', 'error');
    }
  }

  function closeAttendanceModal() {
    document.getElementById('attendance-modal').classList.remove('show');
  }

  function goToAttendance(eventId, eventTitle) {
    closeAttendanceModal();
    window.location.href = '/attendance/' + eventId;
  }
</script>
</body>
</html>
