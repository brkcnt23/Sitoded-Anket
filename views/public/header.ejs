<!DOCTYPE html><html lang="<%= lang %>"><head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title><%= title %></title><meta name="description" content="<%= description %>"><meta name="theme-color" content="#ffffff"><link rel="manifest" href="/manifest.webmanifest"><meta property="og:title" content="<%= title %>"><meta property="og:description" content="<%= description %>"><meta property="og:type" content="website"><link rel="icon" href="/img/site/favicon.ico">
<link rel="stylesheet" href="/vendor/fonts.css">
<link rel="stylesheet" href="/css/site.css?v=20260921"><link rel="stylesheet" href="/css/editorial.css?v=20260921"><script defer src="/js/site.js?v=20260921"></script></head><body class="public-site page-<%= page %>">
<a class="skip-link" href="#main"><%= t('İçeriğe geç','Skip to content') %></a>
<div class="utility"><div class="wrap"><span><%= t('Sivil Toplum Destekleme Derneği · Erzurum','Civil Society Support Association · Erzurum') %></span><div><a href="mailto:sitoded25@gmail.com">sitoded25@gmail.com</a><a id="langToggle" href="<%= currentPath %>?lang=<%= lang === 'tr' ? 'en' : 'tr' %>" aria-label="<%= t('Read in English','Türkçe görüntüle') %>"><%= lang === 'tr' ? 'EN' : 'TR' %></a></div></div></div>
<% const nav=[['/hakkimizda','Hakkımızda','About us','about'],['/calisma-alanlari','Çalışmalarımız','Our work','work'],['/projeler','Projeler','Projects','projects'],['/haberler','Haberler','News','news'],['/cop31','COP31','COP31','cop31'],['/iletisim','İletişim','Contact','contact']]; %>
<header class="site-header"><div class="wrap header-inner"><a class="brand" href="<%= url('/') %>" aria-label="<%= t('SİTODED ana sayfa','SİTODED home') %>"><%- include('brand') %></a><nav class="desktop-nav" aria-label="<%= t('Ana menü','Main navigation') %>"><% nav.forEach(n=>{ %><a href="<%= url(n[0]) %>" <%- page===n[3]?'aria-current="page"':'' %>><%= t(n[1],n[2]) %></a><% }) %></nav><div class="header-actions"><% if (typeof user !== 'undefined' && user) { %><a href="/dashboard" class="login-link">Panelim ↗</a><% } else { %><a href="/login" class="login-link"><%= t('Üye girişi','Member login') %> ↗</a><% } %><a href="/a/gonulluluk" class="button button-small"><%= t('Gönüllü ol','Volunteer') %></a><button class="menu-toggle" id="navToggle" aria-controls="mobileNav" aria-expanded="false" aria-label="<%= t('Menü','Menu') %>"><span></span><span></span></button></div></div><nav id="mobileNav" class="mobile-nav" hidden aria-label="<%= t('Mobil menü','Mobile navigation') %>"><% nav.forEach(n=>{ %><a href="<%= url(n[0]) %>"><%= t(n[1],n[2]) %></a><% }) %><% if (typeof user !== 'undefined' && user) { %><a href="/dashboard">Panelim ↗</a><% } else { %><a href="/login"><%= t('Üye girişi','Member login') %> ↗</a><% } %></nav></header>
