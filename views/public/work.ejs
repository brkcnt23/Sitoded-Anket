<%- include('header') %><main id="main"><section class="page-intro tone-sage"><div class="wrap"><div class="breadcrumbs"><a href="<%= url('/') %>"><%= t('Ana sayfa','Home') %></a><span>/</span><a href="<%= url('/calisma-alanlari') %>"><%= t('Çalışma alanları','Areas of action') %></a></div><div class="split-heading"><div><span class="eyebrow"><%= t('KAPSAYICI BİR YAKLAŞIM','AN INCLUSIVE APPROACH') %></span><h1><%= area?t(area[1],area[2]):t('Yedi alan.','Seven areas.') %><% if(!area){ %><br><em><%= t('Ortak bir sorumluluk.','A shared responsibility.') %></em><% } %></h1><p class="lead"><%= area?t(area[5],area[6]):t('Toplumun farklı ihtiyaçlarına gönüllülük, öğrenme ve dayanışmayla karşılık veriyoruz.','Responding to our communities’ needs through volunteering, learning and solidarity.') %></p></div><% if(area){ %><%- include('picture',{name:area[3]}) %><% }else{ %><div class="page-heading-mark"><%- include('../shared/icon',{name:'people'}) %><span><%= t('GENÇLİK · DAYANIŞMA · KATILIM','YOUTH · SOLIDARITY · PARTICIPATION') %></span></div><% } %></div></div></section><section class="section"><div class="wrap"><% if(area){ %><div class="intro-grid"><div><span class="eyebrow"><%= t('BİRLİKTE HAREKETE GEÇELİM','LET’S ACT TOGETHER') %></span><h2><%= t('İlginizi katkıya dönüştürün.','Turn your interests into a contribution.') %></h2></div><div><p class="lead"><%= t('Gönüllü başvurunuzda ilgi alanlarınızı paylaşın. Deneyiminiz ve öğrenmek istediklerinizle çalışmalarımızın bir parçası olun.','Share your interests in your volunteer application. Bring your experience and curiosity to our work.') %></p><div class="button-row"><a class="button" href="/a/gonulluluk"><%= t('Gönüllü olun','Volunteer') %> ↗</a><a class="text-link" href="<%= url(area[0]==='cevre'?'/cop31':'/projeler') %>"><%= t('İlgili çalışmalar','Explore our work') %> →</a></div></div></div><% }else{ %><div class="focus-grid work-grid"><% areas.forEach((a,i)=>{ %><a class="focus-card" href="<%= url('/calisma-alanlari/'+a[0]) %>"><%- include('picture',{name:a[3],sizes:'(max-width:760px) 92vw, 30vw'}) %><div><span class="project-topic">0<%= i+1 %> / SİTODED</span><h2><%= t(a[1],a[2]) %> ↗</h2><p><%= t(a[5],a[6]) %></p></div></a><% }) %></div><% } %></div></section><%- include('join') %></main><%- include('footer') %>
