<%- include('header') %><main id="main"><section class="page-intro tone-peach"><div class="wrap"><div class="breadcrumbs"><a href="<%= url('/') %>"><%= t('Ana sayfa','Home') %></a><span>/</span><span><%= t('Hakkımızda','About us') %></span></div><div class="split-heading"><div><span class="eyebrow"><%= t('BİZ KİMİZ?','WHO WE ARE') %></span><h1><%= t('Erzurum’da köklenen,','Rooted in Erzurum.') %><br><em><%= t('dünyaya açılan bir hikâye.','Connected to the world.') %></em></h1><p class="lead"><%= t('Gençlerin fikrine, gönüllülüğün gücüne ve birlikte değişimin mümkün olduğuna inanıyoruz.','We believe in young people’s ideas, the power of volunteering and our ability to create change together.') %></p></div><%- include('picture',{name:'women'}) %></div></div></section>
<section class="section"><div class="wrap story-grid"><div class="story-photo"><%- include('picture',{name:'culture'}) %><span class="photo-footnote">ERZURUM · 2006</span></div><div><span class="eyebrow"><%= t('BAŞLANGICIMIZ','OUR BEGINNING') %></span><h2><%= t('Bir şehrin potansiyeline inanarak.','Believing in the potential of a city.') %></h2><p class="lead"><%= t('Sivil Toplum Destekleme Derneği, Şubat 2006’da Erzurum’da kuruldu.','The Civil Society Support Association was founded in Erzurum in February 2006.') %></p><p><%= t('Gençlik aktiviteleri yürüten; ön lisans, lisans ve yüksek lisans düzeyinde eğitim alan kurucu üyelerimizin araştırmaları ortak bir ihtiyacı gösteriyordu: Erzurum’da gençlik ve sivil toplum çalışmalarını geliştirmek.','Our founders, active in youth work while studying at associate, undergraduate and postgraduate level, identified a shared need: strengthening youth and civil society activities in Erzurum.') %></p><p><%= t('Bugün yaklaşık 100 üyemizin tamamı gönüllü. Çocuklardan gençlere, çevreden kültüre uzanan yedi alanda programlar oluşturuyor ve uyguluyoruz.','Today, all of our approximately 100 members are volunteers. We create and deliver programmes across seven areas, from children and youth to environment and culture.') %></p></div></div></section>
<section class="section soft-section"><div class="wrap"><div class="section-heading"><div><span class="eyebrow"><%= t('MİSYONUMUZ','OUR MISSION') %></span><h2><%= t('Dört ilke, ortak bir yön.','Four principles. A shared direction.') %></h2></div><p><%= t('Yerelimizde gençlik, sivil toplum ve STK çalışmalarının daha etkili olmasına ön ayak oluyoruz.','Helping youth, civil society and NGOs become more effective in our community.') %></p></div><div class="mission-grid"><% const missions=[['global','blue','Yerelden uluslararasıya','From local to international','Gençlerin aktifliğini artırıyor, projelerini uluslararası platformlara taşıyabilecekleri alanlar açıyoruz.','Creating opportunities for young people to act locally and connect internationally.'],['solidarity','sand','STK dayanışması','Civil society solidarity','Yerel, ulusal ve uluslararası düzeyde sivil toplum kuruluşlarının etkinliğini güçlendiriyoruz.','Strengthening civil society organisations at local, national and international level.'],['participation','peach','Kararlarda söz sahibi','A voice in decisions','Gençlerin ve STK’ların karar alma süreçlerinde katılımcılığını ve söz sahipliğini artırıyoruz.','Expanding young people’s and NGOs’ participation and voice in decision-making.'],['impact','sage','Birlikte değer üretmek','Creating value together','Bilgi, deneyim ve dayanışmayı buluşturan, sosyoekonomik katma değere sahip bir ağ kuruyoruz.','Building a network that creates socioeconomic value through knowledge, experience and solidarity.']]; missions.forEach((m,i)=>{ %><article class="mission-card tone-<%= m[1] %>"><div class="mission-top"><span>0<%= i+1 %></span><%- include('../shared/icon',{name:['globe','people','dialog','chart'][i]}) %></div><h3><%= t(m[2],m[3]) %></h3><p><%= t(m[4],m[5]) %></p></article><% }) %></div></div></section>
<section class="section"><div class="wrap vision-panel"><div><span class="eyebrow"><%= t('VİZYONUMUZ','OUR VISION') %></span><h2><%= t('“Geleceğin Erzurumu”nu','Building the Erzurum') %><br><em><%= t('birlikte hayal ediyoruz.','of tomorrow, together.') %></em></h2><p class="lead"><%= t('Değişiklik yapabilen, nitelikli projeler üreten ve geleceğe güvenle bakan bir sivil toplum.','A civil society that creates change, delivers effective projects and looks to the future with confidence.') %></p><p><%= t('Sivil toplum hareketinin liderlerini destekliyor, ortak idealleri paylaşan paydaşları bir araya getiriyoruz. Ulusal ve uluslararası eğitimlerde edindiğimiz bilgi ve deneyimi yerelimize aktararak sürekli yenileniyoruz.','We support civil society leaders and bring together stakeholders with shared ideals. We keep learning and share knowledge gained through national and international training with our community.') %></p><a class="text-link" href="<%= url('/projeler') %>"><%= t('Bu yaklaşımın projelerdeki karşılığı','See this approach in our projects') %> →</a></div><div><%- include('picture',{name:'hero'}) %></div></div></section>
<section class="section tone-sand"><div class="wrap"><div class="section-heading"><div><span class="eyebrow"><%= t('ÖĞRENME VE İŞ BİRLİĞİ','LEARNING AND COOPERATION') %></span><h2><%= t('Deneyimi yerelimize taşıyoruz.','Bringing experience home.') %></h2></div></div><div class="program-grid"><article><span class="program-name">Erasmus+</span><h3><%= t('Gençlik ve öğrenme','Youth and learning') %></h3><p><%= t('Gençlik değişimleri ve eğitimlerle kültürlerarası deneyim ve birlikte öğrenme.','Intercultural experience and learning through youth exchanges and training.') %></p><a class="text-link" href="<%= url('/projeler/uluslararasi') %>"><%= t('Uluslararası projelerimiz','Our international projects') %> →</a></article><article><span class="program-name">European Solidarity Corps</span><h3><%= t('Sınırları aşan gönüllülük','Volunteering beyond borders') %></h3><p><%= t('Gençlerin farklı ülkelerde topluma katkı sunabilecekleri dayanışma fırsatları.','Solidarity opportunities for young people to contribute to communities abroad.') %></p><a class="text-link" href="<%= url('/haberler') %>"><%= t('ESC duyuruları','ESC announcements') %> →</a></article><article><span class="program-name"><%= t('Yerel iş birlikleri','Local cooperation') %></span><h3><%= t('Şehrimizle birlikte','Together with our city') %></h3><p><%= t('Üniversiteler, yerel yönetimler ve sivil toplum kuruluşlarıyla deneyim paylaşımı.','Sharing experience with universities, local authorities and civil society organisations.') %></p><a class="text-link" href="https://erzurum.edu.tr/duyuru/etu-sitoded-isbirligi-protokolu1" target="_blank" rel="noopener noreferrer"><%= t('ETÜ iş birliği protokolü','ETÜ cooperation protocol') %> ↗</a></article></div></div></section><%- include('join') %></main><%- include('footer') %>
