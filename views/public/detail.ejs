<%- include('header') %><main id="main"><section class="page-intro tone-<%= item.tone %>"><div class="wrap"><div class="breadcrumbs"><a href="<%= url('/') %>"><%= t('Ana sayfa','Home') %></a><span>/</span><a href="<%= url(isNews?'/haberler':'/projeler') %>"><%= isNews?t('Haberler','News'):t('Projeler','Projects') %></a></div><div class="split-heading"><div><span class="eyebrow"><%= isNews?'ESC · 2026':t(...categories[item.category]) %></span><h1><%= item.title %></h1><span class="status-label"><%= isNews?t('Başvurular kapandı · 22 Mayıs 2026','Applications closed · 22 May 2026'):t('Tamamlanan projeler arşivi','Completed projects archive') %></span></div><%- include('picture',{name:item.art}) %></div></div></section><section class="section"><div class="wrap detail-grid"><article class="article-body"><% if(lang==='en'){ %><p class="archive-note">The original archive text below is in Turkish.</p><% } %><% item.paragraphs.filter(p=>p!==item.title).forEach(p=>{ %><p><%= p %></p><% }) %><div class="article-source"><%= t('Kaynak: SİTODED’in yayımladığı arşiv içeriği.','Source: SİTODED’s published archive.') %> <a href="<%= item.source %>" target="_blank" rel="noopener noreferrer"><%= t('Kaynak kaydı','Original record') %> ↗</a></div></article><aside class="detail-aside tone-sage"><span class="aside-icon"><%- include('../shared/icon',{name:'people'}) %></span><h2><%= t('Siz de katılın.','Join our community.') %></h2><p><%= t('İlgi alanlarınız ve becerilerinizle SİTODED’in gönüllü topluluğunun bir parçası olun.','Become part of SİTODED’s volunteer community with your interests and skills.') %></p><a class="button" href="/a/gonulluluk"><%= t('Gönüllü başvurusu','Volunteer application') %> ↗</a></aside></div></section><section class="section soft-section"><div class="wrap"><div class="section-heading"><h2><%= isNews?t('Diğer duyurular','More announcements'):t('Diğer projeler','More projects') %></h2></div><div class="<%= isNews?'news-grid':'project-grid' %>"><% (isNews?news:projects.filter(p=>p.category===item.category)).filter(p=>p.slug!==item.slug).slice(0,3).forEach(p=>{ %><%- include(isNews?'news-card':'project-card',isNews?{n:p}:{p}) %><% }) %></div></div></section></main><%- include('footer') %>
