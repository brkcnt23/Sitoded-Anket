<%- include('header') %><main id="main"><section class="page-intro tone-blue"><div class="wrap"><div class="breadcrumbs"><a href="<%= url('/') %>"><%= t('Ana sayfa','Home') %></a><span>/</span><span><%= t('Projeler','Projects') %></span></div><div class="split-heading"><div><span class="eyebrow"><%= t('BİRLİKTE ÜRETİYORUZ','CREATING TOGETHER') %></span><h1><%= category ? t(...categories[category]) : t('Yerelden dünyaya,','From local ideas') %><% if(!category){ %><br><em><%= t('iz bırakan çalışmalar.','to lasting connections.') %></em><% } %></h1><p class="lead"><%= t('Gençlik, gönüllülük ve dayanışmayla şekillenen proje birikimimizi keşfedin.','Explore our projects shaped by youth, volunteering and solidarity.') %></p></div><div class="page-heading-mark"><%- include('../shared/icon',{name:'globe'}) %><span><%= t('14 YEREL · 21 ULUSLARARASI PROJE','14 LOCAL · 21 INTERNATIONAL PROJECTS') %></span></div></div></div></section><section class="section"><div class="wrap"><nav class="category-nav" aria-label="<%= t('Proje kategorileri','Project categories') %>"><a href="<%= url('/projeler') %>" <%- !category?'aria-current="page"':'' %>><%= t('Tümü','All') %> <span>35</span></a><% Object.entries(categories).forEach(([key,label])=>{ %><a href="<%= url('/projeler/'+key) %>" <%- category===key?'aria-current="page"':'' %>><%= t(...label) %><% if(key!=='gelecek'){ %> <span><%= projects.filter(p=>p.category===key).length %></span><% } %></a><% }) %></nav><% if(category==='gelecek'){ %><div class="future-panel tone-sage"><%- include('picture',{name:'women'}) %><div><span class="eyebrow"><%= t('YENİ FİKİRLERE AÇIĞIZ','OPEN TO NEW IDEAS') %></span><h2><%= t('Bir sonraki adımı birlikte atalım.','Let’s take the next step together.') %></h2><p><%= t('Yeni projelerin takvimleri ve başvuru bilgileri kesinleştiğinde burada paylaşılacak. İklim çalışmalarımızı COP31 sayfamızdan takip edebilir, gönüllü olarak ekibimize katılabilirsiniz.','New project schedules will be shared here once confirmed. Explore our climate work or join our volunteer community.') %></p><div class="button-row"><a class="button" href="<%= url('/cop31') %>">COP31 & Climate Zero ↗</a><a class="text-link" href="/a/gonulluluk"><%= t('Gönüllü olun','Volunteer') %> →</a></div></div></div><% }else{ const filtered=projects.filter(p=>!category||p.category===category); const featured=filtered.filter(p=>p.featured); %><div class="archive-toolbar"><p class="archive-note"><%= t('Tamamlanan projeler arşivi · Açıklamalar yürütüldükleri dönemi yansıtır.','Completed projects archive · Descriptions reflect the time of each project.') %></p><label class="archive-search"><span><%= t('Projelerde ara','Search projects') %></span><input type="search" id="projectSearch" placeholder="<%= t('Proje adı veya konu…','Project name or topic…') %>"></label></div><% if(featured.length){ %><div class="project-grid"><% featured.forEach(p=>{ %><div class="project-entry" data-search="<%= p.title+' '+p.topic[0] %>"><%- include('project-card',{p}) %></div><% }) %></div><% } %><div class="archive-list"><% filtered.filter(p=>!p.featured).forEach(p=>{ %><a class="archive-row project-entry" data-search="<%= p.title+' '+p.topic[0] %>" href="<%= url('/projeler/'+p.slug) %>"><span class="archive-symbol"><%- include('../shared/icon',{name:p.topic[2]}) %></span><span><small><%= t(...categories[p.category]) %> · <%= t(p.topic[0],p.topic[1]) %></small><strong><%= p.title %></strong><span class="archive-excerpt"><%= p.summary %></span></span><span class="archive-arrow">↗</span></a><% }) %></div><p id="projectEmpty" class="archive-empty" hidden><%= t('Bu aramayla eşleşen proje bulunamadı.','No projects match this search.') %></p><% } %></div></section></main><%- include('footer') %>
