<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/css/theme.css?v=20260921">
  <title>404 — SİTODED</title>
  <link rel="icon" href="/img/site/favicon.ico" type="image/x-icon">

  <link rel="stylesheet" href="/vendor/fonts.css">
  <style>
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: 'DM Sans', sans-serif; background: var(--bg); color: var(--text);
      min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 16px;
    }
    .err-card {
      background: var(--surface); border: 1px solid var(--border); border-radius: 20px;
      padding: 44px 28px; width: 100%; max-width: 440px; text-align: center;
      display: flex; flex-direction: column; gap: 14px; align-items: center; box-shadow: var(--shadow);
    }
    .err-code {
      font-family: 'DM Mono', monospace; font-size: 84px; font-weight: 700; line-height: 1;
      background: linear-gradient(135deg, #f86010, #f80080, #00b0e8);
      -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
    }
    .err-title { font-size: 18px; font-weight: 700; }
    .err-text { font-size: 13px; color: var(--muted); line-height: 1.6; }
    .btn { margin-top: 8px; padding: 11px 26px; }
  </style>
  <script src="/js/theme.js?v=20260921"></script>
  <link rel="stylesheet" href="/css/platform.css?v=20260921">
<link rel="stylesheet" href="/css/workspace.css?v=20260921"><script defer src="/js/workspace.js?v=20260921"></script></head>
<body data-theme="light" class="workspace ws-error">
  <div class="err-card"><a href="/" class="workspace-brand"><%- include('../public/brand') %></a>
    <div class="err-code">404</div>
    <h1 class="err-title">Sayfa Bulunamadı</h1>
    <p class="err-text">Aradığınız sayfa mevcut değil veya taşınmış olabilir.</p>
    <a href="/" class="btn btn-primary">Ana Sayfaya Dön</a>
  </div>
</body>
</html>
