<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Yeni Hesap Oluştur - Sitoded Erzurum</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container-fluid">
            <a class="navbar-brand fw-bold" href="/dashboard">Sitoded Erzurum</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="/admin">Geri Dön</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/logout">Çıkış Yap</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container mt-4">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <h2 class="mb-4">Yeni Hesap Oluştur</h2>

                <% if (typeof error !== 'undefined' && error) { %>
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <%- error %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                <% } %>

                <form method="POST" action="/admin/user/new">
                    <div class="mb-3">
                        <label for="full_name" class="form-label">Ad Soyad *</label>
                        <input type="text" class="form-control" id="full_name" name="full_name" required>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="username" class="form-label">Kullanıcı Adı *</label>
                            <input type="text" class="form-control" id="username" name="username" required>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="email" class="form-label">E-posta *</label>
                            <input type="email" class="form-control" id="email" name="email" required>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="password" class="form-label">Şifre *</label>
                        <input type="password" class="form-control" id="password" name="password" required>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="hierarchy_level" class="form-label">Hiyerarşi Seviyesi *</label>
                            <select class="form-select" id="hierarchy_level" name="hierarchy_level" required>
                                <option value="VOLUNTEER">Gönüllü</option>
                                <option value="JUNIOR">Junior</option>
                                <option value="SENIOR">Senior</option>
                                <option value="COORDINATOR">Koordinatör</option>
                                <option value="PRESIDENT">Başkan</option>
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="body_for" class="form-label">Body Ataması (Junior için)</label>
                            <select class="form-select" id="body_for" name="body_for">
                                <option value="">Seçim Yapınız</option>
                                <% juniors.forEach(junior => { %>
                                    <option value="<%- junior.id %>"><%- junior.full_name %></option>
                                <% }); %>
                            </select>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="teams" class="form-label">Ekipler</label>
                        <select class="form-select" id="teams" name="teams" multiple>
                            <% teams.forEach(team => { %>
                                <option value="<%- team.id %>"><%- team.name %></option>
                            <% }); %>
                        </select>
                        <small class="text-muted">Birden fazla seçmek için Ctrl tuşuna basılı tutunuz</small>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Oluştur</button>
                        <a href="/admin" class="btn btn-secondary">İptal</a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <footer class="bg-dark text-white text-center py-3 mt-5">
        <p>&copy; 2026 Sitoded Erzurum</p>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
