<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Yönetim Paneli - Sitoded Erzurum</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container-fluid">
            <a class="navbar-brand fw-bold" href="/dashboard">Sitoded Erzurum</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="/dashboard">Etkinlikler</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link active" href="/admin">Yönetim Paneli</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/logout">Çıkış Yap</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container mt-4">
        <div class="row mb-4">
            <div class="col-md-12">
                <h1>Yönetim Paneli</h1>
                <a href="/admin/user/new" class="btn btn-primary mt-2">Yeni Hesap Oluştur</a>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                <h4>Kullanıcılar (<%= users.length %>)</h4>
                <div class="table-responsive">
                    <table class="table table-striped table-sm">
                        <thead>
                            <tr>
                                <th>Ad Soyad</th>
                                <th>Seviye</th>
                                <th>Rol</th>
                                <th>Puanlar</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% users.forEach(user => { %>
                                <tr>
                                    <td><%- user.full_name %></td>
                                    <td><span class="badge bg-info"><%- user.hierarchy_level %></span></td>
                                    <td><span class="badge bg-secondary"><%- user.role %></span></td>
                                    <td><%- user.points %></td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="col-md-6">
                <h4>Ekipler (<%= teams.length %>)</h4>
                <div class="table-responsive">
                    <table class="table table-striped table-sm">
                        <thead>
                            <tr>
                                <th>Ekip Adı</th>
                                <th>Lider</th>
                                <th>Açıklama</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% teams.forEach(team => { %>
                                <tr>
                                    <td><%- team.name %></td>
                                    <td><%- team.leader_id ? 'Atanmış' : 'Atanmamış' %></td>
                                    <td><small><%- team.description || '-' %></small></td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <footer class="bg-dark text-white text-center py-3 mt-5">
        <p>&copy; 2026 Sitoded Erzurum</p>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
