<div id="toast-root"></div>

<script>
  const panels = ['overview','users','teams','events','points','attendance','surveys','reports','feedback'];
  const titles = { overview:'Genel Bakış', users:'Kullanıcılar', teams:'Ekipler', events:'Etkinlikler', points:'Puan Yönetimi', attendance:'Yoklama Yönetimi', surveys:'Anketler', reports:'Raporlar', feedback:'Şikayet & Öneri' };

  document.addEventListener('DOMContentLoaded',()=>{const requested=new URLSearchParams(location.search).get('panel');if(panels.includes(requested))showPanel(requested);});

  function toggleMenu() {
    const open=document.getElementById('sidebar').classList.toggle('menu-open');
    document.getElementById('menuToggle').setAttribute('aria-expanded',String(open));
  }

  function showPanel(name) {
    if(!panels.includes(name))return;
    const locationUrl=new URL(location.href);locationUrl.searchParams.set('panel',name);history.replaceState(null,'',locationUrl);
    document.getElementById('menuToggle').setAttribute('aria-expanded','false');
    panels.forEach(p => {
      document.getElementById('panel-' + p).classList.toggle('active', p === name);
    });
    document.querySelectorAll('.nav-item').forEach(el => {
      el.classList.remove('active');el.removeAttribute('aria-current');
      if (el.getAttribute('onclick') === `showPanel('${name}')`) {el.classList.add('active');el.setAttribute('aria-current','page');}
    });
    // Mobilde menüden seçim yapınca menüyü kapat
    const sb = document.getElementById('sidebar');
    if (sb) sb.classList.remove('menu-open');
    document.getElementById('topbar-title').textContent = titles[name];

    // Yoklama paneli için etkinlikleri yükle
    if (name === 'attendance') {
      loadAttendanceEvents();
    }
    // Etkinlikler paneli için etkinlikleri yükle
    if (name === 'events') {
      loadEvents();
    }
    // Anketler paneli için anketleri yükle
    if (name === 'surveys') {
      loadSurveys();
    }
    // Genel bakış kartları
    if (name === 'overview') {
      loadPendingEvaluations();
      loadMonthlyActive();
    }
    // Şikayet & Öneri
    if (name === 'feedback') {
      loadFeedback();
    }
  }

  function escapeHtml(s) {
    return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
    });
  }

  const STATUS_BADGES = {
    BEKLIYOR: '<span class="badge badge-senior">Bekliyor</span>',
    ACIK: '<span class="badge" style="background: rgba(34,197,94,.15); color: #86efac; border: 1px solid rgba(34,197,94,.2);">Açık</span>',
    KAPANDI: '<span class="badge badge-volunteer">Kapandı</span>',
    GECMIS: '<span class="badge" style="background: rgba(6,182,212,.15); color: #22d3ee; border: 1px solid rgba(6,182,212,.2);">Geçmiş</span>',
    IPTAL: '<span class="badge" style="background: rgba(239,68,68,.15); color: #fca5a5; border: 1px solid rgba(239,68,68,.2);">İptal</span>'
  };

  async function loadEvents() {
    try {
      const response = await fetch('/api/admin/events');
      const data = await response.json();

      if (!data.success) {
        showToast('Etkinlikler yüklenemedi: ' + data.error, 'error');
        return;
      }

      const tbody = document.getElementById('events-table');
      if (!data.events.length) {
        tbody.innerHTML = '<tr><td colspan="8" class="empty">Hiç etkinlik yok</td></tr>';
        return;
      }

      tbody.innerHTML = data.events.map(event => {
        const evDate = event.event_date
          ? new Date(event.event_date).toLocaleDateString('tr-TR', { day: 'numeric', month: 'short', year: 'numeric' })
          : '—';
        const openStr = event.registration_open
          ? new Date(event.registration_open).toLocaleDateString('tr-TR', { weekday: 'short', day: 'numeric', month: 'short' }) + ' ' +
            new Date(event.registration_open).toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' })
          : '—';
        const toggleBtn = event.computed_status === 'IPTAL'
          ? '<button class="btn btn-ghost btn-sm" onclick="toggleEventStatus(' + event.id + ', \'ACTIVE\')">Aktifleştir</button>'
          : '<button class="btn btn-ghost btn-sm" style="color:#ef4444;border-color:rgba(239,68,68,.25);" onclick="toggleEventStatus(' + event.id + ', \'CANCELLED\')">İptal</button>';

        return '<tr>' +
          '<td style="font-weight:600;">' + escapeHtml(event.title) + '</td>' +
          '<td>' + evDate + '<div style="font-size:11px;color:var(--muted);font-family:\'DM Mono\',monospace;">' + String(event.start_time || '').substring(0,5) + ' - ' + String(event.end_time || '').substring(0,5) + '</div></td>' +
          '<td>' + escapeHtml(event.team_name || '—') + '</td>' +
          '<td>' + escapeHtml(event.leader_name || '—') + '</td>' +
          '<td>' + event.confirmed_count + '/' + event.capacity + (parseInt(event.queued_count) > 0 ? ' <span style="color:var(--yellow);font-size:11px;">(+' + event.queued_count + ' sıra)</span>' : '') + '</td>' +
          '<td style="font-size:12px;">' + openStr + '</td>' +
          '<td>' + (STATUS_BADGES[event.computed_status] || escapeHtml(event.computed_status)) + '</td>' +
          '<td style="white-space:nowrap;">' +
            '<a href="/event/' + event.id + '/registrations" class="btn btn-ghost btn-sm">Kayıtlar</a> ' +
            '<a href="/attendance/' + event.id + '" class="btn btn-ghost btn-sm">Yoklama</a> ' +
            toggleBtn +
          '</td>' +
        '</tr>';
      }).join('');
    } catch (error) {
      console.error('Etkinlik yükleme hatası:', error);
      showToast('Etkinlikler yüklenirken hata oluştu', 'error');
    }
  }

  async function toggleEventStatus(id, status) {
    try {
      const res = await fetch('/api/admin/event/' + id + '/status', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ status })
      });
      const data = await res.json();
      if (data.success) {
        showToast(data.message, 'success');
        loadEvents();
      } else {
        showToast(data.error, 'error');
      }
    } catch (e) {
      showToast('Hata: ' + e.message, 'error');
    }
  }

  // URL parametrelerinden bildirim göster (yönlendirmeler için)
  document.addEventListener('DOMContentLoaded', () => {
    const qp = new URLSearchParams(window.location.search);
    const msg = qp.get('msg');
    const err = qp.get('err');
    if (msg) toast(msg, 'success');
    if (err) toast(err, 'error');
    if (msg || err) history.replaceState(null, '', '/admin');
  });

  async function loadAttendanceEvents() {
    try {
      const response = await fetch('/api/admin/attendance-events');
      const data = await response.json();

      if (data.success) {
        const tbody = document.getElementById('attendance-events');
        tbody.innerHTML = '';

        if (data.events.length === 0) {
          tbody.innerHTML = '<tr><td colspan="6" class="empty">Yoklama alınabilecek etkinlik bulunamadı</td></tr>';
          return;
        }

        data.events.forEach(event => {
          const row = document.createElement('tr');
          const eventDate = new Date(event.event_date).toLocaleDateString('tr-TR', {
            weekday: 'short',
            day: 'numeric',
            month: 'short',
            year: 'numeric'
          });

          row.innerHTML = `
            <td style="font-weight: 600;">${event.title}</td>
            <td>${eventDate}</td>
            <td>${event.team_name}</td>
            <td>${event.confirmed_count}/${event.capacity}</td>
            <td><span class="badge badge-${event.status === 'COMPLETED' ? 'green' : 'yellow'}">${event.status === 'COMPLETED' ? 'Tamamlandı' : 'Bekliyor'}</span></td>
            <td>
              <a href="/attendance/${event.id}" class="btn btn-primary btn-sm">Yoklama Al</a>
            </td>
          `;
          tbody.appendChild(row);
        });
      } else {
        showToast('Etkinlikler yüklenemedi: ' + data.error, 'error');
      }
    } catch (error) {
      console.error('Etkinlik yükleme hatası:', error);
      showToast('Etkinlikler yüklenirken hata oluştu', 'error');
    }
  }

  function filterUsers() {
    const q = document.getElementById('userSearch').value.toLowerCase();
    document.querySelectorAll('#usersTable tbody tr').forEach(row => {
      const name = row.dataset.name || '';
      const user = row.dataset.user || '';
      row.style.display = (!q || name.includes(q) || user.includes(q)) ? '' : 'none';
    });
  }

  async function submitPoints() {
    const userId = document.getElementById('pts-user').value;
    const amount = parseInt(document.getElementById('pts-amount').value);
    const reason = document.getElementById('pts-reason').value;

    if (!userId || !amount || !reason) {
      toast('Tüm alanları doldurun', 'error'); return;
    }

    try {
      const res = await fetch('/api/admin/points/adjust', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ user_id: parseInt(userId), points_change: amount, reason })
      });
      const data = await res.json();
      if (data.success) {
        toast(`Puan güncellendi → ${data.new_points}`, 'success');
        document.getElementById('pts-user').value = '';
        document.getElementById('pts-amount').value = '';
        document.getElementById('pts-reason').value = '';
        setTimeout(() => location.reload(), 1800);
      } else {
        toast(data.error, 'error');
      }
    } catch (e) {
      toast('Hata: ' + e.message, 'error');
    }
  }

  // ===== ANKETLER =====
  async function loadSurveys() {
    const container = document.getElementById('surveys-list');
    try {
      const res = await fetch('/api/admin/surveys');
      const data = await res.json();
      if (!data.success) {
        container.innerHTML = '<div class="empty" style="padding:24px; text-align:center; color:var(--muted);">' + escapeHtml(data.error) + '</div>';
        return;
      }
      if (!data.surveys.length) {
        container.innerHTML = '<div class="empty" style="padding:24px; text-align:center; color:var(--muted);">Henüz anket yok. Yukarıdan ilk anketini oluştur.</div>';
        return;
      }
      container.innerHTML = data.surveys.map(s => {
        const isOpen = s.status === 'OPEN';
        const badge = isOpen
          ? '<span class="badge" style="background: rgba(34,197,94,.15); color:var(--green); border:1px solid rgba(34,197,94,.2);">Açık</span>'
          : '<span class="badge badge-volunteer">Kapalı</span>';
        const created = s.created_at ? new Date(s.created_at).toLocaleDateString('tr-TR', { day:'numeric', month:'short', year:'numeric' }) : '—';
        return '<div class="survey-row">' +
          '<div class="survey-row-info">' +
            '<div class="survey-row-title">' + escapeHtml(s.title) + '</div>' +
            '<div class="survey-row-meta">/a/' + escapeHtml(s.slug) + ' · ' + s.question_count + ' soru · ' + s.response_count + ' yanıt · ' + created + '</div>' +
          '</div>' +
          badge +
          '<div class="survey-row-actions">' +
            '<a class="btn btn-ghost btn-sm" href="/admin/surveys/' + s.id + '">Düzenle</a>' +
            '<a class="btn btn-ghost btn-sm" href="/admin/surveys/' + s.id + '/responses">Yanıtlar</a>' +
            '<button class="btn btn-ghost btn-sm" onclick="toggleSurvey(' + s.id + ', ' + !isOpen + ')">' + (isOpen ? 'Kapat' : 'Aç') + '</button>' +
            '<button class="btn btn-ghost btn-sm" style="color:#ef4444;border-color:rgba(239,68,68,.25);" onclick="deleteSurvey(' + s.id + ', \'' + escapeHtml(s.title) + '\')">Sil</button>' +
          '</div>' +
        '</div>';
      }).join('');
    } catch (e) {
      container.innerHTML = '<div class="empty" style="padding:24px; text-align:center; color:var(--muted);">Anketler yüklenirken hata oluştu</div>';
    }
  }

  async function createSurvey() {
    const title = document.getElementById('survey-title').value.trim();
    const description = document.getElementById('survey-desc').value.trim();
    if (!title) { toast('Anket başlığı zorunludur', 'error'); return; }
    try {
      const res = await fetch('/api/admin/surveys', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ title, description })
      });
      const data = await res.json();
      if (data.success) {
        toast('Anket oluşturuldu — şimdi soruları ekle', 'success');
        document.getElementById('survey-title').value = '';
        document.getElementById('survey-desc').value = '';
        loadSurveys();
        setTimeout(() => { window.location.href = '/admin/surveys/' + data.data.id; }, 900);
      } else {
        toast(data.error, 'error');
      }
    } catch (e) {
      toast('Hata: ' + e.message, 'error');
    }
  }

  async function toggleSurvey(id, isOpen) {
    try {
      const res = await fetch('/api/admin/surveys/' + id + '/toggle', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ is_open: isOpen })
      });
      const data = await res.json();
      if (data.success) { toast(data.message, 'success'); loadSurveys(); }
      else toast(data.error, 'error');
    } catch (e) {
      toast('Hata: ' + e.message, 'error');
    }
  }

  async function deleteSurvey(id, title) {
    if (!confirm('"' + title + '" anketi ve TÜM yanıtları silinecek. Emin misin?')) return;
    try {
      const res = await fetch('/api/admin/surveys/' + id + '/delete', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' }
      });
      const data = await res.json();
      if (data.success) { toast(data.message, 'success'); loadSurveys(); }
      else toast(data.error, 'error');
    } catch (e) {
      toast('Hata: ' + e.message, 'error');
    }
  }

  // ===== RAPORLAR =====
  function monthlyParams() {
    const m = document.getElementById('rp-month').value;
    if (!m) { toast('Ay seçin', 'error'); return null; }
    return '?month=' + encodeURIComponent(m);
  }
  function volunteerParams() {
    const uid = document.getElementById('rp-user').value;
    return uid ? '?user_id=' + uid : '';
  }
  function derbisParams(kind) {
    let q = '?x=1';
    if (kind === 'movements') {
      const f = document.getElementById('drp-from').value;
      const t = document.getElementById('drp-to').value;
      q += (f ? '&from=' + f : '') + (t ? '&to=' + t : '');
    }
    return q;
  }
  function annualParams() {
    const y = document.getElementById('rp-year').value;
    if (!y) { toast('Yıl girin', 'error'); return null; }
    return '?year=' + encodeURIComponent(y);
  }
  function openReport(url) { if (url) window.open(url, '_blank'); }
  function downloadMonthly() { const p = monthlyParams(); if (p) window.location.href = '/api/admin/reports/events-monthly' + p; }
  function downloadNewsletter() {
    const f = document.getElementById('rp-nl-from').value;
    const t = document.getElementById('rp-nl-to').value;
    const p = (f ? 'from=' + f : '') + (t ? ((f ? '&' : '') + 'to=' + t) : '');
    window.location.href = '/api/admin/reports/events-newsletter' + (p ? '?' + p : '');
  }
  function viewMonthly() { const p = monthlyParams(); openReport(p && ('/api/admin/reports/events-monthly' + p + '&format=html')); }
  function downloadVolunteer() { window.location.href = '/api/admin/reports/volunteer' + volunteerParams(); }
  function viewVolunteer() { openReport('/api/admin/reports/volunteer' + volunteerParams() + (volunteerParams() ? '&' : '?') + 'format=html'); }
  function downloadDerbis(kind) { window.location.href = '/api/admin/reports/derbis/' + kind + derbisParams(kind); }
  function viewDerbis(kind) { openReport('/api/admin/reports/derbis/' + kind + derbisParams(kind) + '&format=html'); }
  function downloadAnnual() { const p = annualParams(); if (p) window.location.href = '/api/admin/reports/derbis/annual' + p; }
  function viewAnnual() { const p = annualParams(); openReport(p && ('/api/admin/reports/derbis/annual' + p + '&format=html')); }

  // ===== DEĞERLENDİRME ANKETİ BEKLEYENLER =====
  async function loadPendingEvaluations() {
    const card = document.getElementById('eval-pending-card');
    const list = document.getElementById('eval-pending-list');
    try {
      const res = await fetch('/api/admin/pending-evaluations');
      const data = await res.json();
      if (!data.success || !data.events.length) { card.style.display = 'none'; return; }
      card.style.display = '';
      list.innerHTML = data.events.map(e => {
        const d = e.event_date ? new Date(e.event_date).toLocaleDateString('tr-TR', { day:'numeric', month:'short', year:'numeric' }) : '';
        return '<div class="survey-row">' +
          '<div class="survey-row-info">' +
            '<div class="survey-row-title">' + escapeHtml(e.title) + '</div>' +
            '<div class="survey-row-meta">' + d + ' · ' + escapeHtml(e.team_name) + ' · ' + e.confirmed_count + ' katılımcı</div>' +
          '</div>' +
          '<div class="survey-row-actions">' +
            '<button class="btn btn-ghost btn-sm" onclick="createEvalSurvey(' + e.id + ', this)"> Anket Oluştur</button>' +
          '</div>' +
        '</div>';
      }).join('');
    } catch (e) {
      card.style.display = 'none';
    }
  }

  async function createEvalSurvey(eventId, btn) {
    btn.disabled = true; btn.textContent = 'Oluşturuluyor…';
    try {
      const res = await fetch('/api/admin/surveys/from-event', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ event_id: eventId })
      });
      const data = await res.json();
      if (data.success) {
        toast(data.message + ' — anketi açmayı unutma', 'success');
        loadPendingEvaluations();
        setTimeout(() => { window.location.href = '/admin/surveys/' + data.data.id; }, 900);
      } else {
        toast(data.error, 'error');
        btn.disabled = false; btn.textContent = ' Anket Oluştur';
      }
    } catch (e) {
      toast('Hata: ' + e.message, 'error');
      btn.disabled = false; btn.textContent = ' Anket Oluştur';
    }
  }

  // ===== AYIN EN AKTİFLERİ =====
  async function loadMonthlyActive() {
    const box = document.getElementById('monthly-active-list');
    try {
      const res = await fetch('/api/admin/stats/monthly-active');
      const data = await res.json();
      if (!data.success) { box.textContent = 'Yüklenemedi'; return; }
      if (!data.users.length) { box.textContent = 'Bu ay henüz yoklama işaretlenmedi.'; return; }
      const medals = ['1.', '2.', '3.', '4.', '5.'];
      box.innerHTML = data.users.map((u, i) =>
        '<div class="survey-row" style="padding:8px 0;">' +
          '<span style="font-size:16px;">' + (medals[i] || (i + 1) + '.') + '</span>' +
          '<div class="survey-row-info"><div class="survey-row-title">' + escapeHtml(u.full_name) + '</div></div>' +
          '<span style="color:var(--accent2);font-weight:700;font-size:13px;">' + u.attended_count + ' etkinlik</span>' +
        '</div>'
      ).join('');
    } catch (e) {
      box.textContent = 'Yüklenemedi';
    }
  }

  // İlk açılışta overview kartlarını yükle
  document.addEventListener('DOMContentLoaded', () => {
    loadPendingEvaluations();
    loadMonthlyActive();
  });

  // ===== ŞİKAYET & ÖNERİ =====
  let fbFilter = '';
  async function loadFeedback() {
    const box = document.getElementById('feedback-list');
    try {
      const res = await fetch('/api/admin/feedback' + (fbFilter ? '?status=' + fbFilter : ''));
      const data = await res.json();
      if (!data.success) { box.innerHTML = '<div class="empty" style="padding:24px;text-align:center;color:var(--muted);">Yüklenemedi</div>'; return; }
      if (!data.feedback.length) {
        box.innerHTML = '<div class="empty" style="padding:24px;text-align:center;color:var(--muted);">Bu filtrede mesaj yok.</div>';
        return;
      }
      const STATUS_BADGE = {
        NEW: '<span class="badge" style="background: rgba(234,179,8,.12); color: var(--yellow); border: 1px solid rgba(234,179,8,.25);">Yeni</span>',
        READ: '<span class="badge" style="background: rgba(6,182,212,.12); color: var(--cyan); border: 1px solid rgba(6,182,212,.25);">Okundu</span>',
        DONE: '<span class="badge" style="background: rgba(34,197,94,.12); color: var(--green); border: 1px solid rgba(34,197,94,.25);">Tamamlandı</span>'
      };
      box.innerHTML = data.feedback.map(f => {
        const d = new Date(f.created_at).toLocaleString('tr-TR', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });
        const kindBadge = f.kind === 'SIKAYET'
          ? '<span class="badge" style="background: rgba(239,68,68,.12); color: var(--red); border: 1px solid rgba(239,68,68,.25);"> Şikayet</span>'
          : '<span class="badge" style="background: rgba(108,99,255,0); color: var(--accent); border: 1px solid var(--border2);"> Öneri</span>';
        const actions = [];
        if (f.status !== 'READ') actions.push('<button class="btn btn-ghost btn-sm" onclick="setFeedbackStatus(' + f.id + ', \'READ\')">Okundu</button>');
        if (f.status !== 'DONE') actions.push('<button class="btn btn-ghost btn-sm" onclick="setFeedbackStatus(' + f.id + ', \'DONE\')">Tamamlandı</button>');
        actions.push('<button class="btn btn-ghost btn-sm" style="color:var(--red);border-color:rgba(239,68,68,.3);" onclick="deleteFeedback(' + f.id + ')">Sil</button>');
        return '<div class="survey-row" style="align-items:flex-start;">' +
          '<div class="survey-row-info" style="flex:1;min-width:0;">' +
            '<div style="display:flex;gap:6px;flex-wrap:wrap;align-items:center;margin-bottom:4px;">' + kindBadge + STATUS_BADGE[f.status] +
              '<span style="font-size:11px;color:var(--muted);font-family:\'DM Mono\',monospace;">' + d + '</span></div>' +
            '<div style="font-size:12px;color:var(--muted);margin-bottom:4px;"> ' + escapeHtml(f.full_name || 'Anonim') + (f.username ? ' (@' + escapeHtml(f.username) + ')' : '') + '</div>' +
            '<div style="font-size:14px;line-height:1.5;white-space:pre-wrap;word-break:break-word;">' + escapeHtml(f.message) + '</div>' +
          '</div>' +
          '<div class="survey-row-actions">' + actions.join(' ') + '</div>' +
        '</div>';
      }).join('');
    } catch (e) {
      box.innerHTML = '<div class="empty" style="padding:24px;text-align:center;color:var(--muted);">Yüklenemedi</div>';
    }
  }
  function setFbFilter(status) {
    fbFilter = status;
    document.querySelectorAll('[id^="fb-filter-"]').forEach(b => { b.style.cssText = ''; });
    const active = document.getElementById('fb-filter-' + (status || 'all'));
    if (active) active.style.cssText = 'border-color: var(--accent); color: var(--accent);';
    loadFeedback();
  }
  async function setFeedbackStatus(id, status) {
    try {
      const res = await fetch('/api/admin/feedback/' + id + '/status', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ status })
      });
      const data = await res.json();
      if (data.success) { toast(data.message, 'success'); loadFeedback(); }
      else toast(data.error, 'error');
    } catch (e) { toast('Hata: ' + e.message, 'error'); }
  }
  async function deleteFeedback(id) {
    if (!confirm('Bu mesaj silinecek. Emin misin?')) return;
    try {
      const res = await fetch('/api/admin/feedback/' + id + '/delete', { method: 'POST' });
      const data = await res.json();
      if (data.success) { toast(data.message, 'success'); loadFeedback(); }
      else toast(data.error, 'error');
    } catch (e) { toast('Hata: ' + e.message, 'error'); }
  }

  function toast(msg, type = 'success') {
    const el = document.createElement('div');
    el.className = 'toast ' + type;
    el.textContent = msg;
    document.getElementById('toast-root').appendChild(el);
    setTimeout(() => el.remove(), 3500);
  }

  // Eski çağrılar için takma ad (loadAttendanceEvents'te showToast kullanılıyordu)
  const showToast = toast;
</script>
</body>
</html>
