<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/css/theme.css?v=20260921">
  <title>Yönetim Paneli — Sitoded</title>
  <link rel="icon" href="/img/site/favicon.ico" type="image/x-icon">

  <link rel="stylesheet" href="/vendor/fonts.css">
  <style>
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: 'DM Sans', sans-serif;
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
      display: flex;
    }

    /* ── SIDEBAR ── */
.sidebar {
  width: 240px;
  min-height: 100vh;
  background: var(--surface);
  border-right: 1px solid var(--border);
  display: flex;
  flex-direction: column;
  position: fixed;
  top: 0;
  left: 0;
  z-index: 100;
}

.sidebar-logo {
  border-bottom: 1px solid var(--border);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 6px 12px 4px;
}

.panel-sidebar-logo {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  gap: 0;
  width: 100%;
}

.panel-logo {
  height: 128px;
  width: auto;
  max-width: 100%;
  display: block;
  margin: 0;
}

.panel-sidebar-logo-text {
  margin: -8px 0 0 0;
  padding: 0;
  line-height: 1;
}

.panel-sidebar-logo-text span {
  display: block;
  font-size: 13px;
  line-height: 1;
  margin: 0;
  padding: 0;
}

    .sidebar-nav {
      padding: 20px 12px;
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: 2px;
    }

    .nav-label {
      font-size: 10px;
      font-weight: 600;
      letter-spacing: 1px;
      text-transform: uppercase;
      color: var(--muted);
      padding: 8px 12px 6px;
      margin-top: 8px;
    }

    .menu-toggle {
      display: none;
      align-items: center;
      gap: 8px;
      padding: 9px 14px;
      border-radius: 8px;
      border: 1px solid var(--border2);
      background: var(--surface2);
      color: var(--text);
      font-size: 13px;
      font-weight: 600;
      font-family: inherit;
      cursor: pointer;
    }
    .menu-toggle:hover { border-color: var(--accent); color: var(--accent2); }

    .nav-item {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 10px 12px;
      border-radius: 8px;
      font-size: 14px;
      font-weight: 500;
      color: var(--muted);
      cursor: pointer;
      transition: all 0.15s;
      text-decoration: none;
      border: none;
      background: none;
      width: 100%;
      text-align: left;
    }

    .nav-item:hover { background: var(--surface2); color: var(--text); }
    .nav-item.active { background: color-mix(in srgb, var(--accent) 15%, transparent); color: var(--accent2); }

    .nav-item svg { width: 16px; height: 16px; flex-shrink: 0; }

    .sidebar-footer {
      padding: 16px 12px;
      border-top: 1px solid var(--border);
    }

    /* ── MAIN ── */
    .main {
      margin-left: 240px;
      flex: 1;
      display: flex;
      flex-direction: column;
    }

    .topbar {
      height: 64px;
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 32px;
      background: var(--surface);
      position: sticky;
      top: 0;
      z-index: 50;
    }

    .topbar-title {
      font-size: 16px;
      font-weight: 600;
      color: var(--text);
    }

    .topbar-right {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .user-chip {
      display: flex;
      align-items: center;
      gap: 8px;
      background: var(--surface2);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 6px 12px;
      font-size: 13px;
      color: var(--text);
    }

    .user-chip-dot {
      width: 8px; height: 8px;
      border-radius: 50%;
      background: var(--green);
    }

    .content {
      padding: 32px;
      flex: 1;
    }

    /* ── PANELS ── */
    .panel {
      display: none;
    }
    .panel.active { display: block; }

    /* ── STAT CARDS ── */
    .stats-row {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
      gap: 16px;
      margin-bottom: 32px;
    }

    .stat-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 20px 24px;
    }

    .stat-label {
      font-size: 12px;
      font-weight: 500;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 0.5px;
      margin-bottom: 10px;
    }

    .stat-value {
      font-size: 32px;
      font-weight: 700;
      color: var(--text);
      line-height: 1;
      font-family: 'DM Mono', monospace;
    }

    .stat-sub {
      font-size: 12px;
      color: var(--muted);
      margin-top: 6px;
    }

    .stat-card.accent .stat-value { color: var(--accent2); }
    .stat-card.green .stat-value { color: var(--green); }
    .stat-card.yellow .stat-value { color: var(--yellow); }

    /* ── SECTION HEADERS ── */
    .section-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 20px;
    }

    .section-head h2 {
      font-size: 17px;
      font-weight: 600;
      color: var(--text);
    }

    .section-head p {
      font-size: 13px;
      color: var(--muted);
      margin-top: 2px;
    }

    /* ── CARD ── */
    .card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 12px;
      overflow: hidden;
      margin-bottom: 24px;
    }

    .card-header {
      padding: 18px 24px;
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .card-header h3 {
      font-size: 14px;
      font-weight: 600;
      color: var(--text);
    }

    .card-body { padding: 24px; }

    /* ── TABLE ── */
    .data-table {
      width: 100%;
      border-collapse: collapse;
    }

    .data-table thead tr {
      border-bottom: 1px solid var(--border);
    }

    .data-table th {
      padding: 10px 16px;
      text-align: left;
      font-size: 11px;
      font-weight: 600;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 0.5px;
      white-space: nowrap;
    }

    .data-table td {
      padding: 13px 16px;
      font-size: 13px;
      color: var(--text);
      border-bottom: 1px solid var(--border);
      vertical-align: middle;
    }

    .data-table tbody tr:last-child td { border-bottom: none; }

    .data-table tbody tr:hover td { background: var(--surface2); }

    /* ── AVATAR ── */
    .avatar {
      width: 32px; height: 32px;
      border-radius: 8px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 12px;
      font-weight: 700;
      flex-shrink: 0;
    }

    .user-cell {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .user-cell-info { display: flex; flex-direction: column; }
    .user-cell-name { font-size: 13px; font-weight: 600; }
    .user-cell-sub { font-size: 11px; color: var(--muted); font-family: 'DM Mono', monospace; }

    /* ── BADGES ── */
    .badge {
      display: inline-flex;
      align-items: center;
      padding: 3px 8px;
      border-radius: 4px;
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.3px;
      text-transform: uppercase;
    }

    .badge-president { background: rgba(168,85,247,0.15); color: #c084fc; border: 1px solid rgba(168,85,247,0.2); }
    .badge-coordinator { background: rgba(6,182,212,0.15); color: #22d3ee; border: 1px solid rgba(6,182,212,0.2); }
    .badge-senior { background: color-mix(in srgb, var(--accent) 15%, transparent); color: #a5b4fc; border: 1px solid color-mix(in srgb, var(--accent) 20%, transparent); }
    .badge-junior { background: rgba(234,179,8,0.15); color: #fde047; border: 1px solid rgba(234,179,8,0.2); }
    .badge-volunteer { background: rgba(255,255,255,0.05); color: var(--muted); border: 1px solid var(--border); }

    .points-pill {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      padding: 3px 8px;
      border-radius: 6px;
      background: rgba(34,197,94,0.1);
      color: var(--green);
      font-size: 13px;
      font-weight: 600;
      font-family: 'DM Mono', monospace;
      border: 1px solid rgba(34,197,94,0.15);
    }

    /* ── FORM ── */
    .form-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
    }

    .form-grid.cols3 { grid-template-columns: 1fr 1fr 1fr; }
    .form-grid.full { grid-template-columns: 1fr; }

    .form-group {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .form-label {
      font-size: 12px;
      font-weight: 600;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 0.4px;
    }

    .form-control {
      background: var(--surface2);
      border: 1px solid var(--border2);
      border-radius: 8px;
      padding: 10px 14px;
      font-size: 14px;
      color: var(--text);
      font-family: 'DM Sans', sans-serif;
      outline: none;
      transition: border-color 0.15s;
      width: 100%;
    }

    .form-control:focus {
      border-color: var(--accent);
      box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 12%, transparent);
    }

    select.form-control option { background: var(--surface2); }

    .form-actions {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-top: 8px;
    }

    /* ── BUTTONS ── */
    .btn {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 9px 18px;
      border-radius: 8px;
      font-size: 13px;
      font-weight: 600;
      font-family: 'DM Sans', sans-serif;
      cursor: pointer;
      border: none;
      transition: all 0.15s;
      text-decoration: none;
      white-space: nowrap;
    }

    .btn-primary { background: var(--accent); color: var(--on-accent); }
    .btn-primary:hover { background: var(--accent2); }

    .btn-ghost {
      background: transparent;
      color: var(--muted);
      border: 1px solid var(--border2);
    }
    .btn-ghost:hover { background: var(--surface2); color: var(--text); }

    .btn-sm { padding: 6px 12px; font-size: 12px; }

    /* ── TOAST ── */
    #toast-root {
      position: fixed;
      top: 20px; right: 20px;
      z-index: 9999;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .toast {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 14px 18px;
      border-radius: 10px;
      font-size: 13px;
      font-weight: 500;
      min-width: 280px;
      animation: slideIn 0.2s ease;
      border: 1px solid;
    }

    .toast.success { background: rgba(22,101,52,0.9); color: #86efac; border-color: rgba(34,197,94,0.3); backdrop-filter: blur(8px); }
    .toast.error { background: rgba(127,29,29,0.9); color: #fca5a5; border-color: rgba(239,68,68,0.3); backdrop-filter: blur(8px); }

    @keyframes slideIn {
      from { transform: translateX(100%); opacity: 0; }
      to   { transform: translateX(0);    opacity: 1; }
    }

    /* ── SEARCH ── */
    .search-wrap {
      position: relative;
    }

    .search-wrap svg {
      position: absolute;
      left: 12px;
      top: 50%;
      transform: translateY(-50%);
      width: 14px; height: 14px;
      color: var(--muted);
    }

    .search-wrap input {
      padding-left: 36px;
    }

    /* ── EMPTY STATE ── */
    .empty {
      text-align: center;
      padding: 48px;
      color: var(--muted);
      font-size: 14px;
    }

    /* ── DIVIDER ── */
    hr { border: none; border-top: 1px solid var(--border); margin: 24px 0; }

    /* ── SURVEYS ── */
    .survey-create-row {
      display: flex;
      gap: 10px;
      padding: 16px 20px;
      flex-wrap: wrap;
    }
    .survey-create-row .form-control { flex: 1 1 220px; min-width: 0; }
    .survey-row {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 14px 20px;
      border-bottom: 1px solid var(--border);
      flex-wrap: wrap;
    }
    .survey-row:last-child { border-bottom: none; }
    .survey-row-info { flex: 1 1 200px; min-width: 0; }
    .survey-row-title {
      font-weight: 600;
      font-size: 14px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .survey-row-meta {
      font-size: 11px;
      color: var(--muted);
      font-family: 'DM Mono', monospace;
      margin-top: 2px;
    }
    .survey-row-actions { display: flex; gap: 6px; flex-wrap: wrap; }

    /* ── MOBILE ── */
    @media (max-width: 900px) {
      .sidebar { width: 200px; }
      .main { margin-left: 200px; }
    }

    @media (max-width: 768px) {
      body { flex-direction: column; }
      .sidebar {
        position: static;
        width: 100%;
        min-height: auto;
        flex-direction: column;
        align-items: stretch;
        padding: 8px 12px;
        gap: 0;
        border-right: none;
        border-bottom: 1px solid var(--border);
      }
      .sidebar-logo {
        border-bottom: none;
        padding: 0;
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        width: 100%;
      }
      .panel-logo { height: 40px; }
      .panel-sidebar-logo-text { display: none; }
      .menu-toggle { display: flex; }
      .sidebar-nav { display: none; flex-direction: column; padding: 8px 0 4px; overflow: visible; }
      .sidebar.menu-open .sidebar-nav { display: flex; }
      .nav-label { display: block; }
      .nav-item { padding: 12px 12px; white-space: normal; width: 100%; }
      .sidebar-footer { display: none; }
      .sidebar.menu-open .sidebar-footer { display: block; border-top: none; padding: 0 0 6px; }
      .main { margin-left: 0; }
      .topbar { padding: 0 16px; }
      .content { padding: 20px 16px; }
      .stats-row { grid-template-columns: repeat(2, 1fr); }
      .card { overflow-x: auto; }
    }
  </style>
  <script src="/js/theme.js?v=20260921"></script>
  <link rel="stylesheet" href="/css/platform.css?v=20260921">
<link rel="stylesheet" href="/css/workspace.css?v=20260921"><script defer src="/js/workspace.js?v=20260921"></script></head>
<body data-theme="light" class="workspace ws-admin">
<% const _now = new Date(); const thisMonth = `${_now.getFullYear()}-${String(_now.getMonth()+1).padStart(2,'0')}`; const thisDay = `${thisMonth}-${String(_now.getDate()).padStart(2,'0')}`; %>
<!-- SIDEBAR -->
<aside class="sidebar" id="sidebar">
  <div class="sidebar-logo panel-sidebar-logo">
    <a href="/" class="workspace-brand"><%- include('../public/brand') %></a>
    <div class="sidebar-logo-text panel-sidebar-logo-text">
      <span>Yönetim Paneli</span>
    </div>
    <button class="menu-toggle" id="menuToggle" aria-controls="adminNav" aria-expanded="false" onclick="toggleMenu()">
      <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
      Menü
    </button>
  </div>
  <nav class="sidebar-nav" id="adminNav" aria-label="Yönetim menüsü">
    <span class="nav-label">Genel</span>
    <button class="nav-item active" onclick="showPanel('overview')">
      <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
      Genel Bakış
    </button>

    <span class="nav-label">Yönetim</span>
    <button class="nav-item" onclick="showPanel('users')">
      <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
      Kullanıcılar
    </button>
    <button class="nav-item" onclick="showPanel('teams')">
      <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
      Ekipler
    </button>
    <button class="nav-item" onclick="showPanel('events')">
      <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
      Etkinlikler
    </button>
    <button class="nav-item" onclick="showPanel('points')">
      <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
      Puan Yönetimi
    </button>
    <button class="nav-item" onclick="showPanel('attendance')">
      <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M9 12l2 2 4-4M21 12c0 4.97-4.03 9-9 9s-9-4.03-9-9 4.03-9 9-9 9 4.03 9 9z"/></svg>
      Yoklama Yönetimi
    </button>
    <button class="nav-item" onclick="showPanel('surveys')">
      <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2M9 5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2M9 5a2 2 0 0 0 2 2h2a2 2 0 0 0 2-2"/><path d="M9 12h6M9 16h6"/></svg>
      Anketler
    </button>
    <button class="nav-item" onclick="showPanel('reports')">
      <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M9 17v-4M13 17V9M17 17v-6"/></svg>
      Raporlar
    </button>
    <button class="nav-item" onclick="showPanel('feedback')">
      <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
      Şikayet &amp; Öneri
    </button>
  </nav>

  <div class="sidebar-footer">
    <a href="/dashboard" class="nav-item" style="text-decoration:none; color: var(--muted);">
      <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" width="16" height="16"><path d="M19 12H5M12 5l-7 7 7 7"/></svg>
      Üye paneline dön
    </a>
  </div>
</aside>

<!-- MAIN -->
<div class="main">
  <!-- TOPBAR -->
  <header class="topbar">
    <span class="topbar-title" id="topbar-title">Genel Bakış</span>
    <div class="topbar-right">
      <div class="user-chip">
        <div class="user-chip-dot"></div>
        <%= user.full_name %>
        <span style="color: var(--muted); font-size:11px;">· <%= user.hierarchy_level %></span>
      </div>
      <a href="/logout" class="btn btn-ghost btn-sm">Çıkış</a>
    </div>
  </header>

  <div class="content">

    <!-- ── OVERVIEW PANEL ── -->
    <div class="panel active" id="panel-overview"><section class="workspace-welcome admin-welcome"><div><span class="workspace-eyebrow">SİTODED / YÖNETİM MERKEZİ</span><h1>Topluluğun çalışmalarını<br>tek yerden yönetin.</h1><p>Üyeler, ekipler, etkinlikler ve geri bildirimler.</p><div class="welcome-actions"><button class="btn btn-primary" onclick="showPanel('events')">Etkinlikleri yönet</button><button class="btn btn-ghost" onclick="showPanel('surveys')">Anketlere git ↗</button></div></div><img src="/img/editorial/culture-640.webp" width="300" height="200" alt=""></section>
      <div class="section-head" style="margin-bottom:28px;">
        <div>
          <h2>Genel Bakış</h2>
          <p>Sistemin anlık durumu</p>
        </div>
        <a href="/admin/user/new" class="btn btn-primary">
          <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" width="14" height="14"><path d="M12 5v14M5 12h14"/></svg>
          Yeni Kullanıcı
        </a>
      </div>

      <div class="stats-row">
        <div class="stat-card accent">
          <div class="stat-label">Toplam Kullanıcı</div>
          <div class="stat-value"><%= users.length %></div>
          <div class="stat-sub">Kayıtlı üye</div>
        </div>
        <div class="stat-card green">
          <div class="stat-label">Ekip Sayısı</div>
          <div class="stat-value"><%= teams.length %></div>
          <div class="stat-sub">Aktif ekip</div>
        </div>
        <div class="stat-card yellow">
          <div class="stat-label">Admin / Senior</div>
          <div class="stat-value"><%= users.filter(u => u.role === 'ADMIN' || u.role === 'SENIOR').length %></div>
          <div class="stat-sub">Yönetici</div>
        </div>
        <div class="stat-card">
          <div class="stat-label">Gönüllü</div>
